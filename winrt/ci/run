#!/bin/bash
# run <script.sh|command> [args...]: runs in the builder container, with /opt/winrt shared with
# the runner and this checkout at /opt/winrt/repo. Privileged for the ciopfs (FUSE) mounts.
set -e
case "$1" in *.sh) set -- bash "/opt/winrt/repo/winrt/ci/$1" "${@:2}" ;; esac
exec docker run --rm --privileged -v /opt/winrt:/opt/winrt -v "${GITHUB_WORKSPACE:-$PWD}:/opt/winrt/repo" \
  -e GITHUB_REPOSITORY winrt-builder "$@"

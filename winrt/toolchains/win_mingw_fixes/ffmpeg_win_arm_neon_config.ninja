# Generates ffmpeg's win/arm-neon configuration (both brandings) for the
# ffmpeg revision in the tree, on the build host with the port's pinned
# llvm-mingw toolchain, the same way every other Chromium ffmpeg config cell is
# produced: chromium/scripts/build_ffmpeg.py (configure + make), whose outputs
# copy_config.sh then copies into chromium/config/<branding>/win/arm-neon/.
# The build.arm-neon.win/ directories and configure's scratch files stay inside
# the build directory. Run with any build directory, e.g.
#   ninja -C out/chrome108 -f /home/winrt/toolchains/win_mingw_fixes/ffmpeg_win_arm_neon_config.ninja ffmpeg_win_arm_neon_config

tc = /home/winrt/sdk/llvm-mingw-winrt/bin

rule build_ffmpeg
  command = rm -rf ffmpeg_cfg && mkdir -p ffmpeg_cfg/tmp && cd ffmpeg_cfg && TMPDIR=$$PWD/tmp python3 ../../../third_party/ffmpeg/chromium/scripts/build_ffmpeg.py win arm-neon -- --cc=$tc/armv7-w64-mingw32-clang --cxx=$tc/armv7-w64-mingw32-clang++ --ld=$tc/armv7-w64-mingw32-clang --ar=$tc/llvm-ar --nm=$tc/llvm-nm --ranlib=$tc/llvm-ranlib --strip=$tc/llvm-strip > ../ffmpeg_cfg.log 2>&1 && touch ../$out
  description = FFMPEG CONFIG win arm-neon (log: ffmpeg_cfg.log)
  pool = console

build ffmpeg_win_arm_neon_config.stamp: build_ffmpeg ../../third_party/ffmpeg/chromium/scripts/build_ffmpeg.py
build ffmpeg_win_arm_neon_config: phony ffmpeg_win_arm_neon_config.stamp

+      return w.Finish();
+    }
+  }
+
+  // REV / REV16 / REVSH / RBIT: cond 0110 1x11 1111 Rd 1111 xx11 Rm.
+  // RBIT (0x06FF0F30) shares the family; it is LIVE codegen (kArmRbit <-
+  // Word32ReverseBits; i32.ctz/i64.ctz in Liftoff), so it must encode, not
+  // FATAL. Thumb T1 RBIT = 0xFA90|Rm : 0xF0A0|Rd<<8|Rm, same shape as REV.
+  if ((instr & 0x0FFF0FF0) == 0x06BF0F30 ||
+      (instr & 0x0FFF0FF0) == 0x06BF0FB0 ||
+      (instr & 0x0FFF0FF0) == 0x06FF0FB0 ||
+      (instr & 0x0FFF0FF0) == 0x06FF0F30) {
+    const uint32_t rd = (instr >> 12) & 0xF, rm = instr & 0xF;
+    // Thumb REV/REV16/REVSH/RBIT forbid sp(13)/pc(15) in BOTH Rd and Rm.
+    if (rd == 15 || rd == 13 || rm == 15 || rm == 13) return false;
+    uint16_t op = 0xF080;  // REV
+    if ((instr & 0x0FFF0FF0) == 0x06BF0FB0) op = 0xF090;   // REV16
+    if ((instr & 0x0FFF0FF0) == 0x06FF0FB0) op = 0xF0B0;   // REVSH
+    if ((instr & 0x0FFF0FF0) == 0x06FF0F30) op = 0xF0A0;   // RBIT

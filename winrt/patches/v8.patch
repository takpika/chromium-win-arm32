+  // Cortex-A15 (Surface 2) and the SQ1 both have.  Thumb-2 T1:
+  //   sdiv: 1111 1011 1001 Rn : 1111 Rd 1111 Rm ; udiv: ...1011 Rn...
+  if ((instr & 0x0FF0F0F0) == 0x0710F010 ||
+      (instr & 0x0FF0F0F0) == 0x0730F010) {

+    w.Wide(0xF3AF, static_cast<uint16_t>(0x8000 | (instr & 0xFF)));
+    return w.Finish();
+  }
+
+  // Jump table dispatch (add pc,pc,Rm,lsl#2) never reaches here: Thumb-2 has no
+  // such computed-pc form, so the assembler does not build the A32 word at all.
+  // CodeGenerator::AssembleArchTableSwitch emits a Thumb-native dispatch instead
+  // (adr/add/orr/bx into an inline B.W table); see code-generator-arm.cc. A stray
+  // data-processing write to pc is still rejected loudly below (rd == 15).
+
+  // B / BL (space 0x5) is not handled here: branches carry a layout-dependent
+  // displacement, so the assembler emits them through dedicated native-Thumb code
+  // (Assembler::b/bl + the Label link chain, which manage the Thumb pc/offset

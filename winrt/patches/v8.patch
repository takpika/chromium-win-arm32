+        if (set_flags && (opcode == 0xD || opcode == 0xF)) return false;
+        const uint32_t imm8 = instr & 0xFF;
+        const uint32_t rot2 = ((instr >> 8) & 0xF) * 2;
+        const uint32_t rn_raw = (instr >> 16) & 0xF;
+        const uint32_t rd_raw = (instr >> 12) & 0xF;
+        if (!mapped.rn_is_pc && (rn_raw == 15 || rn_raw == 13)) return false;
+        if (!mapped.rd_is_pc && (rd_raw == 15 || rd_raw == 13)) return false;
+        // Only unconditional: under a false predicate the A32 op leaves rd
+        // untouched, but materialising the constant into rd (movw/movt cannot be
+        // folded into one IT block with the op) would clobber it. The
+        // conditional case falls through to the temp path, which rejects it.
+        if (cond == kCondAlways && !mapped.rd_is_pc && !mapped.rn_is_pc &&
+            rd_raw <= 12 && rd_raw != rn_raw) {
+          // rd is a dead, free GPR: build the constant in it, then op rd,rn,rd.
+          if (logical_carry) {
+            EmitMaterializeImmWithCarry(&w, rd, imm8, rot2);
+          } else {
+            EmitMovwMovt(&w, rd, value);
+          }
+          EmitDataRegister(&w, mapped.op, set_flags, rn, rd, rd, 0, 0);
+          return w.Finish();
+        }
+        // Borrow a temp != rn,rd (and not sp/pc) and save/restore it. Keep the
+        // whole sequence unconditional (an IT covers only one instruction).
+        if (cond != kCondAlways) return false;
+        uint32_t temp = 0;
+        while (temp == rn_raw || temp == rd_raw) ++temp;  // temp in {0,1,2}, <=r12
+        w.Half(static_cast<uint16_t>(0xB400 | (1u << temp)));  // push {temp}
+        if (logical_carry) {
+          EmitMaterializeImmWithCarry(&w, temp, imm8, rot2);
+        } else {
+          EmitMovwMovt(&w, temp, value);
+        }
+        EmitDataRegister(&w, mapped.op, set_flags, rn, rd, temp, 0, 0);
+        w.Half(static_cast<uint16_t>(0xBC00 | (1u << temp)));  // pop {temp}
+        return w.Finish();
+      }

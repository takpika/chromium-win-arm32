+    const uint32_t rm = (instr >> 8) & 0xF;   // divisor
+    const uint32_t rn = instr & 0xF;          // dividend
+    // Rd/Rn/Rm==pc(15)/sp(13) UNPREDICTABLE in Thumb; lr(14) is valid.
+    if (rd == 13 || rd == 15 || rm == 13 || rm == 15 || rn == 13 || rn == 15) {
+      return false;
+    }

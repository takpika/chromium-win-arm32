+        // whose data-dependent immediate is A32-valid but not ThumbExpandable).
+        // Arithmetic ops take C/V from the ALU, so they keep the plain movw/movt.
+        const bool logical_carry =
+            set_flags && (opcode == 0x0 || opcode == 0x1 || opcode == 0x8 ||
+                          opcode == 0x9 || opcode == 0xC || opcode == 0xE);
+        // MOVS/MVNS with a non-expandable immediate are moves, not covered by the
+        // register-form op below; they are vanishingly rare (V8 builds such

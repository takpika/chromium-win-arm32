+// Record RelocInfo::INTERNAL_REFERENCE at the 4-aligned literal of a far-JUMP
+// trampoline whose 12-byte cell starts at t (== pc_). RecordRelocInfo positions the
+// entry at pc_, so momentarily advance pc_ to the literal, record, restore. The
+// literal holds an absolute in-buffer address (target|1); RelocInfo::apply relocates
+// it at the buffer->Code copy and any move (*p += delta; delta is even so the bit0
+// Thumb tag survives), and GrowBuffer relocates it in-buffer.
+void Assembler::WinRTRecordFarJumpReloc(Address t) {
+  DCHECK_EQ(t, reinterpret_cast<Address>(pc_));
+  // The literal's bit0 Thumb tag survives RelocInfo::apply(*p += delta) only if every
+  // code-move delta is even. buffer_start_ is pointer-aligned and the final Code
+  // instruction_start is kCodeAlignment-aligned, so all deltas are even -- assert the
+  // buffer half of that here (the Code half is guaranteed by kCodeAlignment).
+  DCHECK_EQ(reinterpret_cast<uintptr_t>(buffer_start_) & 1, 0u);
+  byte* saved = pc_;
+  // Parity from the BUFFER OFFSET (not the absolute address) -- see FarJumpWordOffset.
+  const int cell_off = static_cast<int>(saved - buffer_start_);
+  const int word_off = winrt_thumb::FarJumpWordOffset(cell_off);
+  pc_ += word_off;
+  // (1) Record an INTERNAL_REFERENCE reloc entry so the absolute in-buffer literal
+  // is relocated when the code is copied to its final Code location (RelocInfo::apply).
+  // This is arm's first INTERNAL_REFERENCE in generated code. Code::IsIsolateIndependent
+  // treats any INTERNAL_REFERENCE as isolate-DEPENDENT, so a far veneer must never
+  // appear in an embedded builtin. It cannot: a far veneer is emitted only for a span
+  // > +-16MB, and every embedded builtin is bounded far below that -- embedded-data.cc
+  // CHECKs the whole blob's raw_code_size <= kMaxPCRelativeCodeRangeInMB*MB (16MB), so
+  // no single builtin reaches the veneer threshold. Were that ever violated, mksnapshot's
+  // own IsIsolateIndependent CHECK would abort at build time (loud, never silent).
+  RecordRelocInfo(RelocInfo::INTERNAL_REFERENCE);
+  pc_ = saved;
+  // (2) Track the literal's buffer offset so GrowBuffer() can bump it in place when
+  // the assembly buffer itself moves (mirrors x64 internal_reference_positions_).
+  winrt_internal_ref_positions_.push_back(cell_off + word_off);

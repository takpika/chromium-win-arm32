+           static_cast<uint16_t>(0xF0F0 | (rd << 8) | rm));
+    return w.Finish();
+  }
+
+  // SMMUL: cond 0111 0101 Rd 1111 Rs 0001 Rm.  Mask bit5 (the R rounding bit)
+  // so only SMMUL (R=0, the form V8 emits -- see Assembler::smmul) matches;
+  // SMMULR (R=1) would need Thumb's R bit set and is never emitted, so it must
+  // not silently ride this SMMUL encoding.
+  if ((instr & 0x0FF0F0F0) == 0x0750F010) {
+    const uint32_t rd = (instr >> 16) & 0xF, rs = (instr >> 8) & 0xF;
+    const uint32_t rm = instr & 0xF;
+    // Rd/Rm/Rs==pc(15)/sp(13) UNPREDICTABLE.
+    if (rd == 13 || rd == 15 || rs == 13 || rs == 15 || rm == 13 || rm == 15) {
+      return false;
+    }
+    if (cond != kCondAlways) EmitIT(&w, cond);
+    w.Wide(static_cast<uint16_t>(0xFB50 | rm),
+           static_cast<uint16_t>(0xF000 | (rd << 8) | rs));
+    return w.Finish();
+  }
+
+  // SMMLA: cond 0111 0101 Rd Ra Rm 0001 Rn (Ra != 1111; Ra==1111 is SMMUL
+  // above). R (rounding, bit5) must be 0 -- the form V8 emits (kArmSmmla <-
+  // Int32Add(Int32MulHigh,..), the div-by-constant lowering), so it must encode
+  // rather than FATAL. Thumb T1: 1111 1011 0101 Rn : Ra Rd 0000 Rm.
+  if ((instr & 0x0FF000F0) == 0x07500010 && ((instr >> 12) & 0xF) != 0xF) {
+    const uint32_t rd = (instr >> 16) & 0xF, ra = (instr >> 12) & 0xF;
+    const uint32_t rm = (instr >> 8) & 0xF, rn = instr & 0xF;
+    // Rd/Ra/Rm/Rn==pc(15)/sp(13) UNPREDICTABLE (ra==15 is SMMUL, already excluded
+    // by the != 0xF guard above).
+    if (rd == 13 || rd == 15 || ra == 13 || rm == 13 || rm == 15 || rn == 13 ||
+        rn == 15) {
+      return false;
+    }
+    if (cond != kCondAlways) EmitIT(&w, cond);
+    w.Wide(static_cast<uint16_t>(0xFB50 | rn),
+           static_cast<uint16_t>((ra << 12) | (rd << 8) | rm));
+    return w.Finish();
+  }
+
+  // V8 marks a constant pool with a permanently undefined instruction whose
+  // low bits carry the pool length, and the branch over the pool means it is
+  // never executed - but it still occupies a slot, and the disassembler reads
+  // it, so keep the payload VALUE and use Thumb's own undefined encoding.
+  // A32 UDF packs imm16 = imm12:imm4 ([19:8] is the HIGH 12 bits, [3:0] the low 4);
+  // Thumb-2 T2 UDF packs imm16 = imm4:imm12 (hw1[3:0] HIGH, hw2[11:0] low). The two
+  // field layouts DIFFER, so the payload must be re-split across the halves, not copied
+  // field-for-field -- a verbatim copy silently swaps them (udf #5 -> udf.w #20480) and
+  // corrupts the pool length EncodeConstantPoolLength/DecodeConstantPoolLength

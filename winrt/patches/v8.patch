diff --git a/src/baseline/arm/baseline-assembler-arm-inl.h b/src/baseline/arm/baseline-assembler-arm-inl.h
index 5cb855e416e24090b9f8f897c5f1e581535048f0..26ae75c305a762e7f2f53de66d7d32b3d8c793ef 100644
--- a/src/baseline/arm/baseline-assembler-arm-inl.h
+++ b/src/baseline/arm/baseline-assembler-arm-inl.h
@@ -535,6 +535,53 @@ void BaselineAssembler::Switch(Register reg, int case_value_base,
   }
 
   // Mostly copied from code-generator-arm.cc
+#if V8_WINRT_NATIVE_THUMB_EMIT
+  // Native Thumb-2 has no `add pc, pc, reg lsl #2` (Rd==pc data-proc is
+  // UNPREDICTABLE and the encoder rejects it -> emit() FATAL). Mirror the
+  // device-proven TurboFan native jump table (code-generator-arm.cc
+  // AssembleArchTableSwitch): ADR the table base, index it, set the Thumb
+  // interworking bit, and bx into an inline table of self-patched B.W entries.
+  // cmp BEFORE acquiring the scratch (a non-modified-immediate num_labels needs
+  // ip to build the immediate, and ip is the only arm scratch).
+  __ cmp(reg, Operand(num_labels));
+  // Flush any pending pool, then block it across the fixed-layout table. (No
+  // veneer drain is needed: conditional branches are chain-linked B.W lowerings,
+  // not off-chain fixups, so a blocked region cannot starve one.)
+  __ CheckConstPool(true, true);
+  __ BlockConstPoolFor(num_labels + 8);
+  // Use ip DIRECTLY (r12) for the table-address scratch, matching the device-
+  // proven TurboFan dispatch's Rd. Baseline's
+  // ScratchRegisterScope Includes r8/r9/r5, so scope.AcquireScratch() would
+  // return r8 -- a DIFFERENT Rd than the tested byte sequence. ip is free here
+  // (dead after the bx; the cmp's own internal use of ip completed above).
+  Register temp = ip;
+  CHECK(temp != reg);
+  // reg >= num_labels: skip the dispatch + table straight to the fallthrough.
+  // reg >= num_labels: skip the dispatch + table to the fallthrough. fallthrough
+  // is a forward unbound label, so Assembler::b(Label*,cond) lowers this to an
+  // inverted-condition skip over a CHAIN-LINKED unconditional B.W (+-16MB reach),
+  // which is emitted BEFORE adr_pos below and so does not affect the table layout
+  // (table_pos is measured from adr_pos). No B<c>.W / veneer pool is involved.
+  __ b(hs, &fallthrough);
+  // Table follows adr(4) + add(4) + orr(4) + bx(2) = 14 bytes. ADR base =
+  // Align(pc+4,4) with pc = the adr's address; Code objects are kCodeAlignment-
+  // aligned so buffer pc_offset() has the same (mod 4) parity as the runtime pc
+  // (both parities device-covered).
+  const int adr_pos = __ pc_offset();
+  const int table_pos = adr_pos + 14;
+  const int adr_base = (adr_pos + winrt_thumb::kPcLoadDelta) & ~3;
+  __ WinRTEmitThumbAdr(temp, static_cast<uint32_t>(table_pos - adr_base));
+  __ add(temp, temp, Operand(reg, LSL, 2));  // temp = &table[reg]
+  __ orr(temp, temp, Operand(1));            // set Thumb interworking bit
+  __ bx(temp);
+  // Loud invariant: any dispatch-size drift would make the ADR immediate wrong.
+  CHECK_EQ(__ pc_offset(), table_pos);
+  for (int i = 0; i < num_labels; ++i) {
+    __ b(labels[i]);  // 4-byte B.W, self-patched by the Label chain
+  }
+  // (out-of-range falls straight through to `fallthrough`, bound just below --
+  // no branch-to-next.)
+#else
   ScratchRegisterScope scope(this);
   JumpIf(Condition::kUnsignedGreaterThanEqual, reg, Operand(num_labels),
          &fallthrough);
@@ -547,6 +594,7 @@ void BaselineAssembler::Switch(Register reg, int case_value_base,
   for (int i = 0; i < num_labels; ++i) {
     __ b(labels[i]);
   }
+#endif
   __ bind(&fallthrough);
 }
 

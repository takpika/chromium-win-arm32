+++ b/src/codegen/arm/winrt-thumb-encoder.h
@@ -0,0 +1,96 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef V8_CODEGEN_ARM_WINRT_THUMB_ENCODER_H_
+#define V8_CODEGEN_ARM_WINRT_THUMB_ENCODER_H_
+
+#include <cstdint>
+
+namespace v8 {
+namespace internal {
+
+// Windows-on-ARM32 runs user-mode code in Thumb state only, so V8 must emit
+// Thumb-2 for generated code and for the embedded builtins (the latter by a
+// native arm mksnapshot; v8/BUILD.gn asserts the clang_arm snapshot
+// toolchain because the x86 arm simulator executes, and therefore emits, A32).
+//
+// This is the emit-time encoder: Assembler::emit() (assembler-arm-inl.h) passes
+// each A32 word to winrt_thumb::EmitThumbSlot (winrt-thumb-patch.h), the only
+// caller of WinRTEncodeThumbSlot, and copies the *out_bytes it returns, so
+// pc_offset() is the real Thumb cursor and every offset V8 records from it
+// (labels, safepoints, handler tables, source positions, const-pool deltas) is
+// correct by construction. There is no later pass and no offset remap. Offsets
+// V8 derives from a fixed instruction count instead of pc_offset() are fixed at
+// their sites (e.g. Deoptimizer::kEagerDeoptExitSize, deoptimizer-arm.cc).
+// Forms whose meaning depends on layout -- branches, constant-pool loads, ADR,
+// the table-switch dispatch, deopt exits, wasm jump slots -- are emitted
+// natively by the assembler/code generator and never reach this function.
+//
+// Transcoding is one-to-one except where Thumb-2 has no spelling for the A32
+// form (register-shifted-register operands, out-of-reach offsets, immediates
+// A32 can rotate but ThumbExpandImm cannot). Those are lowered with a register
+// that is provably dead (the instruction's own destination) or a push/pop
+// temporary. `add/sub sp, Rn(!=sp), ...` is REJECTED here: its only emitters
+// (MacroAssembler::EnterExitFrame, LiftoffAssembler::PrepareTailCall,
+// Builtins::Generate_CEntry) lower it themselves through a register they know
+// is free. A push/pop temporary moves sp down by 4 or 8 inside a call-free
+// window; nothing below sp is live, so no data is exposed. No lowering moves
+// a base register it does not write anyway (an out-of-reach load builds the
+// address in its destination, a store in a pushed temporary), so fp/r10 are
+// never observed shifted. `ldr pc, [rn, #imm]` is transcoded one-to-one to
+// LDR.W pc (same bit0 interworking as A32 LoadWritePC); no scratch is used.
+//
+// One lowering changes a value: A32 `str pc, [rn, #imm]` stores this+8, which
+// Thumb cannot spell. The encoder emits `push {t0,t1}; mov t0, pc; addw/subw
+// t1, rn, #imm; str t0, [t1]; pop {t0,t1}` and stores sequence-start + 6 (an
+// even address inside the caller), rejecting rn == sp/pc. The only `str pc`
+// that reaches it is TurboAssembler::CallCFunctionHelper's store into
+// fast_c_call_caller_pc, which StackFrameIteratorBase uses only to identify
+// the calling code (frames.cc: fast C calls save no c_entry_fp and cannot GC),
+// so any address inside the caller is sound. The wasm C-API exit frame, whose
+// stored pc must equal the recorded safepoint pc, does not use `str pc` on
+// win-arm32: CodeGenerator emits a native ADR of the exact safepoint address.
+// Generate_DeoptimizationEntry's STM-with-pc is replaced for win-arm32 by
+// explicit stores (builtins-arm.cc), so no STM listing pc reaches here either.
+//
+// kWinRTThumbSlotSize (16) bounds the largest lowering, which is exactly 16
+// bytes (push 2 + mov.w/rors.w carry materialization 8 + op 4 + pop 2). The
+// SlotWriter overflow check is a loud emit-time FATAL; the caller copies only
+// the real length, so nothing is padded in the code buffer.
+//
+// Any A32 form the encoder cannot express makes it return false, which the
+// caller turns into a FATAL at emit time -- never a silent wrong encoding.
+// Flag semantics: a flag-setting logical immediate whose Thumb carry-out would
+// differ from A32's is rejected, and a non-ThumbExpandable immediate is built
+// with a carry-matching `mov.w; rors.w` (EmitMaterializeImmWithCarry).
+//
+// Verification: encoding validity of every accepted word (an exhaustive
+// guard-completeness sweep); register+NZCV equivalence with A32 on both
+// devices, 560 stubs; a per-instruction differential, 610 stubs incl. the
+// base-fold and `ldr pc` families, on the Surface Pro X; and real V8 codegen
+// through this encoder: the native mksnapshot and a Pro X d8 running mjsunit
+// (the reject FATAL did not fire).
+//
+// Branch reach: B.W/BL reach +-16MB (A32 b reaches +-32MB). Far branches are
+// routed through an ldr.w-pc island cell (winrt-thumb-patch.h) and far chain
+// links through a side table, so reach is not reduced (see assembler-arm.cc);
+// a far conditional becomes an inverted skip over a chain-linked B.W.
+constexpr int kWinRTThumbSlotSize = 16;
+
+// Translates one A32 instruction word into one fixed-size Thumb-2 slot.
+// Returns false when the encoding is not handled yet, so callers can report
+// the gap instead of emitting something that would silently misbehave. On a
+// true return, *out_bytes is the real length (before nop padding) the caller
+// must copy; on a false return it is 0. The length travels through this
+// out-param (not a thread_local), so the encode and its length cannot be read
+// out of step.
+bool WinRTEncodeThumbSlot(uint32_t arm_instruction,
+                          uint8_t out[kWinRTThumbSlotSize], int* out_bytes);
+
+// Name of the instruction class for diagnostics on an unhandled encoding.
+const char* WinRTDescribeArmInstruction(uint32_t arm_instruction);
+
+}  // namespace internal
+}  // namespace v8
+
+#endif  // V8_CODEGEN_ARM_WINRT_THUMB_ENCODER_H_

+// Little-endian halfword writer: Thumb-2 is a stream of halfwords, and a wide
+// instruction is the pair (first, second) in that order.
+class SlotWriter {
+ public:
+  // `real_bytes` receives the count of real instruction bytes (before the nop
+  // padding) on a successful Finish(); Assembler::emit() copies exactly that
+  // many bytes, packing the buffer densely -- no 16-byte padding in the code.
+  // The length is returned through this caller-owned out-param rather than a
+  // thread_local side channel, so the (encode, length) pair cannot be torn or
+  // read stale.
+  SlotWriter(uint8_t* out, int* real_bytes) : out_(out), real_bytes_(real_bytes) {}
+
+  void Half(uint16_t value) {
+    if (used_ + 2 > kWinRTThumbSlotSize) {
+      overflow_ = true;
+      return;
+    }
+    out_[used_] = static_cast<uint8_t>(value & 0xFF);
+    out_[used_ + 1] = static_cast<uint8_t>(value >> 8);
+    used_ += 2;
+  }
+
+  void Wide(uint16_t first, uint16_t second) {
+    Half(first);
+    Half(second);
+  }
+
+  // Pad the rest of the slot with wide nops so the slot is always the same
+  // size no matter how many instructions the translation needed.
+  bool Finish() {
+    if (overflow_) return false;
+    if (real_bytes_) *real_bytes_ = used_;
+    while (used_ + 4 <= kWinRTThumbSlotSize) Wide(0xF3AF, 0x8000);  // nop.w
+    while (used_ + 2 <= kWinRTThumbSlotSize) Half(0xBF00);          // nop
+    return !overflow_ && used_ == kWinRTThumbSlotSize;
+  }
+
+ private:
+  uint8_t* out_;
+  int* real_bytes_;
+  int used_ = 0;
+  bool overflow_ = false;
+};
+
+constexpr uint32_t kCondAlways = 0xE;
+
+uint32_t Cond(uint32_t instr) { return instr >> 28; }
+
+// ThumbExpandImm reads imm12 = i:imm3:imm8 as either one of four replicated
+// byte patterns (when i:imm3:imm8<7> is below 8) or as ROR(0x80|imm8<6:0>,
+// i:imm3:imm8<7>).  The rotation is therefore the amount the byte is rotated
+// *right* to land on the value, and its low bit is carried in imm8<7> rather
+// than in the field the caller builds from `rotation_out`.
+bool ThumbExpandable(uint32_t value, uint16_t* rotation_out,
+                     uint16_t* imm8_out) {
+  if (value < 0x100) {
+    *rotation_out = 0;
+    *imm8_out = static_cast<uint16_t>(value);
+    return true;
+  }
+  const uint32_t byte = value & 0xFF;
+  if (byte != 0) {
+    // The replicated patterns select on i:imm3, so the rotation the caller
+    // encodes is the pattern number doubled.
+    if (value == ((byte << 16) | byte)) {
+      *rotation_out = 2;
+      *imm8_out = static_cast<uint16_t>(byte);
+      return true;
+    }
+    if (value == ((byte << 24) | (byte << 16) | (byte << 8) | byte)) {
+      *rotation_out = 6;
+      *imm8_out = static_cast<uint16_t>(byte);
+      return true;
+    }
+  }
+  const uint32_t high = (value >> 8) & 0xFF;
+  if (high != 0 && value == ((high << 24) | (high << 8))) {
+    *rotation_out = 4;
+    *imm8_out = static_cast<uint16_t>(high);
+    return true;
+  }
+  for (uint32_t rotation = 8; rotation <= 31; ++rotation) {
+    const uint32_t unrotated =
+        (value << rotation) | (value >> (32 - rotation));  // ROL == undo ROR
+    if (unrotated < 0x80 || unrotated > 0xFF) continue;
+    *rotation_out = static_cast<uint16_t>(rotation);
+    // imm8<7> is the low bit of the rotation; the constant's own top bit is
+    // implicit in the encoding.
+    *imm8_out =
+        static_cast<uint16_t>(((rotation & 1) << 7) | (unrotated & 0x7F));
+    return true;
+  }
+  return false;
+}
+
+// ADDW/SUBW take a plain 12-bit immediate with none of ThumbExpandImm's
+// restrictions, so any A32 offset fits in one instruction.
+void EmitAddSubW(SlotWriter* w, bool subtract, uint32_t rd, uint32_t rn,
+                 uint32_t imm12) {
+  const uint32_t i = (imm12 >> 11) & 1;
+  const uint32_t imm3 = (imm12 >> 8) & 0x7;
+  const uint32_t imm8 = imm12 & 0xFF;
+  w->Wide(static_cast<uint16_t>((subtract ? 0xF2A0 : 0xF200) | (i << 10) | rn),
+          static_cast<uint16_t>((imm3 << 12) | (rd << 8) | imm8));
+}
+
+
+// movw/movt is the only way to get an arbitrary 32-bit constant into a
+// register without a literal pool, and the slot has room for the pair.
+void EmitMovwMovt(SlotWriter* w, uint32_t rd, uint32_t value) {
+  const uint32_t lo = value & 0xFFFF, hi = (value >> 16) & 0xFFFF;
+  w->Wide(static_cast<uint16_t>(0xF240 | (((lo >> 11) & 1) << 10) |
+                                ((lo >> 12) & 0xF)),
+          static_cast<uint16_t>((((lo >> 8) & 0x7) << 12) | (rd << 8) |
+                                (lo & 0xFF)));
+  if (hi == 0) return;
+  w->Wide(static_cast<uint16_t>(0xF2C0 | (((hi >> 11) & 1) << 10) |
+                                ((hi >> 12) & 0xF)),
+          static_cast<uint16_t>((((hi >> 8) & 0x7) << 12) | (rd << 8) |
+                                (hi & 0xFF)));
+}
+
+// Materialise an A32 modified immediate (value = ror(imm8, rot2), rot2 != 0)
+// into `rd` AND set C = value<31>, matching the shifter carry a flag-setting
+// logical op would produce. `mov.w rd,#imm8` (imm8 <= 255) then `rors.w rd,rd,
+// #rot2` (S=1): the last bit rotated out is bit(rot2-1) of imm8 = value<31>, so
+// C is exact while rd = value. Only used when the value is NOT ThumbExpandable,
+// which guarantees rot2 != 0 (rot2 == 0 means value == imm8, expandable).
+void EmitMaterializeImmWithCarry(SlotWriter* w, uint32_t rd, uint32_t imm8,
+                                 uint32_t rot2) {
+  w->Wide(0xF04F, static_cast<uint16_t>((rd << 8) | (imm8 & 0xFF)));
+  w->Wide(0xEA5F, static_cast<uint16_t>(((rot2 >> 2) << 12) | (rd << 8) |
+                                        ((rot2 & 3) << 6) | (3u << 4) | rd));
+}
+
+// Thumb-2 data processing, register form with a shift by immediate.
+void EmitDataRegister(SlotWriter* w, uint32_t op, uint32_t set_flags,
+                      uint32_t rn, uint32_t rd, uint32_t rm, uint32_t shift_imm,
+                      uint32_t shift_type) {
+  w->Wide(static_cast<uint16_t>(0xEA00 | (op << 5) | (set_flags << 4) | rn),
+          static_cast<uint16_t>((((shift_imm >> 2) & 0x7) << 12) | (rd << 8) |
+                                ((shift_imm & 0x3) << 6) | (shift_type << 4) |
+                                rm));
+}
+
+// Thumb-2 shift by register: LSL/LSR/ASR/ROR rd, rm, rs. With set_flags the S
+// bit (hw1 bit 4) is set so the shift also writes C = shifter carry-out (used to
+// carry the A32 shifter carry into a following logical flag-setter).
+void EmitShiftByRegister(SlotWriter* w, uint32_t shift_type, uint32_t rd,
+                         uint32_t rm, uint32_t rs, uint32_t set_flags = 0) {
+  w->Wide(static_cast<uint16_t>(0xFA00 | (shift_type << 5) | (set_flags << 4) |
+                                rm),
+          static_cast<uint16_t>(0xF000 | (rd << 8) | rs));
+}
+
+// IT makes the next instruction conditional; the slot always holds exactly one
+
+// conditional instruction, so the mask is the "then" form.
+void EmitIT(SlotWriter* w, uint32_t cond) {
+  w->Half(static_cast<uint16_t>(0xBF00 | (cond << 4) | 0x08));
+}
+
+// ITT <cond>: predicate the next TWO instructions (both "then"). The IT mask
+// for a length-2 all-then block is firstcond[0]<<3 | 0b0100 (cf. IT = 0b1000).
+void EmitIT2(SlotWriter* w, uint32_t cond) {
+  const uint32_t mask = ((cond & 1u) << 3) | 0x4u;
+  w->Half(static_cast<uint16_t>(0xBF00 | (cond << 4) | mask));
+}
+
+// A32 opcode (bits 24..21) -> Thumb-2 modified-immediate op field, with the
+// flag-setting comparisons folded onto their arithmetic forms.
+struct ThumbDataOp {
+  uint8_t op;        // Thumb-2 op field
+  bool valid;
+  bool rn_is_pc;     // MOV/MVN take Rn = 0b1111
+  bool rd_is_pc;     // TST/TEQ/CMP/CMN take Rd = 0b1111
+  bool force_flags;
+};
+
+ThumbDataOp MapDataOp(uint32_t a32_opcode) {
+  switch (a32_opcode) {
+    case 0x0: return {0x0, true, false, false, false};   // AND
+    case 0x1: return {0x4, true, false, false, false};   // EOR
+    case 0x2: return {0xD, true, false, false, false};   // SUB
+    case 0x3: return {0xE, true, false, false, false};   // RSB
+    case 0x4: return {0x8, true, false, false, false};   // ADD
+    case 0x5: return {0xA, true, false, false, false};   // ADC
+    case 0x6: return {0xB, true, false, false, false};   // SBC
+    case 0x8: return {0x0, true, false, true,  true};    // TST
+    case 0x9: return {0x4, true, false, true,  true};    // TEQ
+    case 0xA: return {0xD, true, false, true,  true};    // CMP
+    case 0xB: return {0x8, true, false, true,  true};    // CMN
+    case 0xC: return {0x2, true, false, false, false};   // ORR
+    case 0xD: return {0x2, true, true,  false, false};   // MOV
+    case 0xE: return {0x1, true, false, false, false};   // BIC
+    case 0xF: return {0x3, true, true,  false, false};   // MVN
+    default:  return {0x0, false, false, false, false};
+  }
+}
+
+uint32_t RotatedImmediate(uint32_t instr) {
+  const uint32_t imm8 = instr & 0xFF;
+  const uint32_t rotate = ((instr >> 8) & 0xF) * 2;
+  if (rotate == 0) return imm8;
+  return (imm8 >> rotate) | (imm8 << (32 - rotate));
+}

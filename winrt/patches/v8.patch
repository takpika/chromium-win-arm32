+namespace v8 {
+namespace internal {
+
+// Thumb-2 instruction encode/decode primitives for native win-arm32 emission
+// (the assembler emits these shapes) and for the relocation machinery, which
+// decodes/patches the three shapes that can carry a relocatable target in
+// natively-emitted Thumb code: a constant-pool load (T2 LDR literal, itself
+// always cond==al), a movw/movt immediate pair, and a direct B.W/BL branch.
+// There is NO far-literal form. A CONDITIONAL pooled load is emitted as
+// `IT{cond}` + an UNCONDITIONAL LDR.W, and the RelocInfo/pool entry is recorded
+// at the LDR (past the IT) -- so the instruction AT the reloc pc is always the
+// unconditional LDR and the readers never see or skip an IT there (the IT sits
+// one halfword before the reloc pc). Conditional branches are T3, IT-free.
+//
+// movw and movt are both 4-byte wide (.w) encodings emitted back-to-back, so the
+// second half of the pair is exactly 4 bytes after the first (kPairStride == 4).
+namespace winrt_thumb {
+
+inline uint16_t Half(Address pc) {
+  uint16_t v;
+  memcpy(&v, reinterpret_cast<void*>(pc), sizeof(v));
+  return v;
+}
+
+inline void SetHalf(Address pc, uint16_t v) {
+  memcpy(reinterpret_cast<void*>(pc), &v, sizeof(v));
+}
+
+// LDR (literal), T2: 1111 100 0 U 101 1111 : Rt imm12.
+inline bool IsLdrPcImmediate(Address pc) {
+  return (Half(pc) & 0xFF7F) == 0xF85F;
+}
+
+inline Address ConstantPoolEntryAddress(Address pc) {
+  const uint16_t hw1 = Half(pc), hw2 = Half(pc + 2);
+  const uint32_t imm12 = hw2 & 0x0FFF;
+  const Address base = (pc + 4) & ~static_cast<Address>(3);
+  return ((hw1 >> 7) & 1) ? base + imm12 : base - imm12;
+}
+
+// Signed pc-relative displacement of an LDR.W (literal) T2 at pc (U ? +imm12 :
+// -imm12).  Base for the address is Align(pc+4,4) (see ConstantPoolEntryAddress).
+inline int32_t LdrPcSignedDelta(Address pc) {
+  const int imm12 = Half(pc + 2) & 0x0FFF;
+  return ((Half(pc) >> 7) & 1) ? imm12 : -imm12;
+}
+
+// Write the pc-relative displacement into an LDR.W (literal) T2 at pc, keeping
+// Rt.  delta = pool_entry - Align(pc+4,4); |delta| must be <= 4095.
+inline void SetLdrPcImmediate(Address pc, int32_t delta) {
+  const uint32_t U = delta >= 0 ? 1u : 0u;
+  const uint32_t imm12 =
+      static_cast<uint32_t>(delta >= 0 ? delta : -delta) & 0x0FFF;
+  SetHalf(pc, static_cast<uint16_t>(0xF85F | (U << 7)));  // 1111100 U 1011111
+  SetHalf(pc + 2, static_cast<uint16_t>((Half(pc + 2) & 0xF000) | imm12));
+}
+
+// MOVW/MOVT (immediate), T3: 1111 0 i 10 x100 imm4 : 0 imm3 Rd imm8.
+// MOVW/MOVT T3: hw1 carries the opcode, hw2 = `0 imm3 Rd imm8` so hw2 bit15 == 0.
+// A T4 B.W / T1 BL has hw2 bit15 == 1, and for certain branch displacements its
+// hw1 aliases the movw/movt opcode bits (e.g. imm10 making hw1 == 0xF240), so
+// hw1 alone is NOT a sufficient discriminator against a branch (it would misdecode
+// a RELATIVE_CODE_TARGET B.W as movw and corrupt it).
+// Require hw2 bit15 == 0 so movw/movt can never collide with B.W/BL.
+inline bool IsMovW(Address pc) {
+  return (Half(pc) & 0xFBF0) == 0xF240 && (Half(pc + 2) & 0x8000) == 0;
+}
+inline bool IsMovT(Address pc) {
+  return (Half(pc) & 0xFBF0) == 0xF2C0 && (Half(pc + 2) & 0x8000) == 0;
+}
+
+inline uint32_t MovImmediate(Address pc) {
+  const uint32_t hw1 = Half(pc), hw2 = Half(pc + 2);
+  return ((hw1 & 0xF) << 12) | (((hw1 >> 10) & 1) << 11) |
+         (((hw2 >> 12) & 0x7) << 8) | (hw2 & 0xFF);
+}
+
+inline void SetMovImmediate(Address pc, uint32_t imm16) {
+  const uint16_t hw1 = static_cast<uint16_t>(
+      (Half(pc) & 0xFBF0) | (((imm16 >> 11) & 1) << 10) | ((imm16 >> 12) & 0xF));
+  const uint16_t hw2 = static_cast<uint16_t>((Half(pc + 2) & 0x8F00) |
+                                             (((imm16 >> 8) & 0x7) << 12) |
+                                             (imm16 & 0xFF));
+  SetHalf(pc, hw1);
+  SetHalf(pc + 2, hw2);
+}
+
+// Dense emission: the movt (a 4-byte wide Thumb-2 encoding) follows the movw
+// immediately, so the second half of a materialised 32-bit constant is 4 bytes
+// after the first.
+constexpr int kPairStride = 4;
+
+// B.W (T4) and BL (T1): 1111 0 S imm10 : 1 0 J1 x J2 imm11.
+inline bool IsBOrBl(Address pc) {
+  // Bit 14 of the second halfword is what separates BL from B.W, so it must
+  // not be part of the test - or the match would only ever find B.W.
+  return (Half(pc) & 0xF800) == 0xF000 && (Half(pc + 2) & 0x9000) == 0x9000;
+}
+
+inline int32_t BranchOffset(Address pc) {
+  const uint32_t hw1 = Half(pc), hw2 = Half(pc + 2);
+  const uint32_t sign = (hw1 >> 10) & 1;
+  const uint32_t j1 = (hw2 >> 13) & 1, j2 = (hw2 >> 11) & 1;
+  const uint32_t i1 = (j1 ^ sign) ^ 1, i2 = (j2 ^ sign) ^ 1;
+  uint32_t off = (sign << 24) | (i1 << 23) | (i2 << 22) |
+                 ((hw1 & 0x3FF) << 12) | ((hw2 & 0x7FF) << 1);
+  if (sign) off |= 0xFE000000;
+  return static_cast<int32_t>(off);
+}
+
+inline void SetBranchOffset(Address pc, int32_t offset) {
+  const uint32_t off = static_cast<uint32_t>(offset);
+  const uint32_t sign = (off >> 24) & 1;
+  const uint32_t j1 = (((off >> 23) & 1) ^ 1) ^ sign;
+  const uint32_t j2 = (((off >> 22) & 1) ^ 1) ^ sign;
+  SetHalf(pc, static_cast<uint16_t>(0xF000 | (sign << 10) |
+                                    ((off >> 12) & 0x3FF)));
+  // Keep bit 14: it is the only thing that still says whether this is a call.
+  SetHalf(pc + 2, static_cast<uint16_t>((Half(pc + 2) & 0x4000) | 0x9000 |
+                                        (j1 << 13) | (j2 << 11) |
+                                        ((off >> 1) & 0x7FF)));
+}
+
+// B<cond>.W (T3): 1111 0 S cond(4) imm6 : 1 0 J1 0 J2 imm11.  Range +-1MB.
+// imm32 = SignExtend(S:J2:J1:imm6:imm11:'0', 21) -- unlike T4, J1/J2 are NOT
+// XORed with S.  Distinguished from B.W/BL (T4/T1) by bit 12 of hw2 (0 here,
+// 1 there).  cond 111x is reserved (that space is B.W/BL/misc), so a real
+// conditional never collides.  Verified against llvm-objdump across +-1MB.
+inline bool IsBcW(Address pc) {
+  return (Half(pc) & 0xF800) == 0xF000 && (Half(pc + 2) & 0xD000) == 0x8000 &&
+         ((Half(pc) >> 6) & 0xF) != 0xF && ((Half(pc) >> 6) & 0xE) != 0xE;
+}
+
+inline int BcWCondition(Address pc) { return (Half(pc) >> 6) & 0xF; }
+
+inline int32_t BcWBranchOffset(Address pc) {
+  const uint32_t hw1 = Half(pc), hw2 = Half(pc + 2);
+  const uint32_t S = (hw1 >> 10) & 1;
+  const uint32_t imm6 = hw1 & 0x3F, imm11 = hw2 & 0x7FF;
+  const uint32_t j1 = (hw2 >> 13) & 1, j2 = (hw2 >> 11) & 1;
+  uint32_t off = (S << 20) | (j2 << 19) | (j1 << 18) | (imm6 << 12) | (imm11 << 1);
+  if (S) off |= 0xFFE00000;  // sign-extend from bit 20
+  return static_cast<int32_t>(off);
+}
+
+// Reachable range of a T3 conditional branch (even, +-1MB inclusive of the
+// last encodable value).
+inline bool BcWOffsetInRange(int32_t offset) {
+  return (offset & 1) == 0 && offset >= -(1 << 20) && offset <= ((1 << 20) - 2);
+}
+
+// Write a fresh B<cond>.W (T3) at pc with the given condition and even offset
+// (target - (pc + 4)).  Caller must have checked BcWOffsetInRange.
+inline void SetBcWBranch(Address pc, int cond, int32_t offset) {
+  const uint32_t o = static_cast<uint32_t>(offset);
+  const uint32_t imm11 = (o >> 1) & 0x7FF, imm6 = (o >> 12) & 0x3F;
+  const uint32_t j1 = (o >> 18) & 1, j2 = (o >> 19) & 1, S = (o >> 20) & 1;
+  SetHalf(pc, static_cast<uint16_t>(0xF000 | (S << 10) |
+                                    ((cond & 0xF) << 6) | imm6));
+  SetHalf(pc + 2, static_cast<uint16_t>(0x8000 | (j1 << 13) | (j2 << 11) | imm11));
+}
+
+// Reachable range of a T4/T1 wide unconditional branch / call (even, +-16MB).
+inline bool BOrBlOffsetInRange(int32_t offset) {
+  return (offset & 1) == 0 && offset >= -(1 << 24) && offset <= ((1 << 24) - 2);
+}
+
+// ---- Far-branch veneer island (unconditional branch beyond +-16MB) -----------
+// A single Code object can exceed the +-16MB reach of a T4/T1 branch (a maximal
+// wasm Liftoff body, kV8MaxWasmFunctionSize=7.65MB, expands past 16MB of machine
+// code), and native Thumb B.W/BL reach only +-16MB vs A32's +-32MB. Mirroring
+// arm64's VeneerPool, EVERY out-of-range unconditional branch -- forward or bound,
+// jump or call -- is emitted as a FIXED 4-byte B.W/BL and rerouted through the
+// single non-clobbering ldr.w-pc island cell below (kFarBranchTrampolineSize=12).
+// There is NO variable-size inline trampoline and NO ip form: a 4-byte branch keeps
+// fixed-stride jump tables intact, and a far CALL is a 4-byte BL to the island (the BL
+// sets lr; the island only forwards to the target; the callee returns past the BL), so
+// no register is clobbered on any path.
+constexpr int kFarBranchTrampolineSize = 12;
+
+// ---- Non-clobbering far-branch island cell (ldr.w pc) -------------------------
+// `ldr.w pc,[pc,#4]` loads the target straight into pc from an inline literal --
+// touching NO register. This is the SOLE far-branch veneer form: every far branch
+// (forward or bound, jump or call) routes through it. A far CALL is a 4-byte BL to this
+// island cell -- the BL sets lr, the cell only forwards -- so there is no ip form and
+// no register clobber anywhere. Fixed 12 bytes. The runtime `ldr.w pc,[pc,#4]` reads
+// its literal from Align(pc,4)+4 (pc = cell+4), which is ALWAYS 4-aligned, so the read
+// never faults; correctness instead requires the WORD to be WRITTEN at that same slot.
+// FarJumpWordOffset returns exactly that slot from the cell's buffer offset: cell 4-
+// aligned -> word@+8; cell 2-mod-4 -> word@+6 (both 4-aligned). (An earlier imm=2 layout
+// made the LOADED address itself 2-mod-4 and did fault STATUS_DATATYPE_MISALIGNMENT
+// 0x80000002 on Pro X/WoW64; imm=4 fixes that.) The 12-byte cell is ldr.w@t + NOP.n pads
+// + the 4-aligned .word; the size is fixed 12, matching the CALL path's 4-byte-BL+island
+// so island sizing is uniform. The literal (target|1, Thumb-tagged) is an
+// INTERNAL_REFERENCE: the assembler records it at the word position, sets it at
+// bind/drain, arm32 GrowBuffer relocates it (+pc_delta), and RelocInfo::apply fixes the
+// final Code move (delta is even, so the bit0 Thumb tag survives).
+// Encoding: 0xF8DF (LDR.W literal, Rn=pc, U=1) : 0xF004 (Rt=pc=0xF, imm12=4).
+// The cell is kFarBranchTrampolineSize (12) bytes; there is one size constant, no drift.
+
+// Byte offset (from cell start) of the 4-aligned literal. The parity is taken from the
+// cell's BUFFER OFFSET (cell_off), NOT its emit-time absolute address: at RUNTIME the
+// `ldr.w pc,[pc,#4]` resolves the literal from the Code address, and Code::instruction_
+// start is kCodeAlignment(32)-aligned, so the runtime cell address has the same low-2
+// bits as cell_off -- whereas the emit-time absolute address matches only if
+// buffer_start_ happens to be 4-aligned (an invariant we must NOT depend on, and which
+// GrowBuffer could change). Offset-based is also stable across GrowBuffer (cell_off is
+// fixed). literal at Align(pc,4)+4: cell_off 4-aligned -> +8; cell_off 2-mod-4 -> +6.
+inline int FarJumpWordOffset(int cell_off) { return (cell_off & 2) ? 6 : 8; }
+
+// Write the 4-byte literal (= target|1) at the 4-aligned slot (halfword-wise). `t` is
+// the cell's absolute write address; `cell_off` is its buffer offset (for parity).
+inline void SetFarJumpTarget(Address t, int cell_off, Address target) {
+  const uint32_t v = static_cast<uint32_t>(target) | 1u;  // Thumb interworking bit
+  const int wo = FarJumpWordOffset(cell_off);
+  // By construction wo makes (cell_off + wo) 4-aligned (wo is 8 when cell_off is 4-
+  // aligned, 6 when 2-mod-4; cell_off is always even in Thumb), which is exactly where
+  // the runtime `ldr.w pc,[pc,#4]` reads (Align(pc,4)+4). This CHECK is therefore a
+  // by-construction assertion, not a runtime-reachable guard: it cannot fire today, and
+  // exists to catch a FUTURE wo/parity bug at build time. Such a bug would not fault
+  // (the loaded address is always Align(pc,4)+4, itself 4-aligned) -- it would write the
+  // word at the wrong slot, so ldr.w pc would read the wrong target. CHECK (not DCHECK)
+  // because SetFarJumpTarget runs once per veneer (the rare >16MB path), never hot. The
+  // bit0 Thumb tag on `v` survives RelocInfo::apply's `*p += delta` because every code-
+  // move delta is EVEN: instruction_start is kCodeAlignment(32)-aligned and the buffer is
+  // pointer-aligned, so buffer->Code and GC-compaction deltas are multiples of >=2.
+  CHECK_EQ((cell_off + wo) & 3, 0);
+  SetHalf(t + wo, static_cast<uint16_t>(v & 0xFFFF));
+  SetHalf(t + wo + 2, static_cast<uint16_t>(v >> 16));
+}
+
+// Emit the 12-byte non-clobbering jump trampoline at t (buffer offset cell_off); the
+// literal is a placeholder until SetFarJumpTarget (called at bind / island resolve).
+// NOP.n fills every halfword; SetFarJumpTarget then overwrites the two halfwords of
+// the 4-aligned literal slot (t+8..t+11 when cell_off is 4-aligned, t+6..t+9 when it
+// is 2-mod-4). The genuine remaining pads are t+4 (always) plus t+6 (4-aligned case)
+// or t+10 (2-mod-4 case).
+inline void EmitFarJumpTrampoline(Address t, int cell_off) {
+  SetHalf(t, 0xF8DF);                             // ldr.w pc,[pc,#4] hw1
+  SetHalf(t + 2, 0xF004);                         // hw2: Rt=pc, imm12=4
+  SetHalf(t + 4, 0xBF00);                         // nop.n
+  SetHalf(t + 6, 0xBF00);                         // nop.n
+  SetHalf(t + 8, 0xBF00);                         // nop.n
+  SetHalf(t + 10, 0xBF00);                        // nop.n
+  SetFarJumpTarget(t, cell_off, static_cast<Address>(0));  // placeholder literal
+}
+
+// SHARED far-veneer island PLAN (the risky selection/ordering logic, hoisted so a
+// host-side test drives THIS body, not a copy).
+// From `count` pending forward-branch byte positions pos[], select those whose
+// +-16MB reach `horizon` would exceed (pos + reach - margin <= horizon) and write
+// their indices to out_idx[] SORTED by pos ASCENDING -- oldest/tightest-redirect
+// first, so the branches with the least slack get the lowest trampoline offsets,
+// maximizing how many fit before the caller's loud CHECK(BOrBlOffsetInRange)
+// backstop (the overflow response is that hard CHECK, not graceful degradation).
+// Returns the count. out_idx[] must have room for `count` entries (only [0,ret)
+// are written). (`reach`=+-16MB, `margin`=island headroom; shipped constants.)
+// Host-verified over count>=2 / unsorted / partial inputs; the
+// swap-remove-produced unsorted n=3 island is device-run (both devices).
+inline int PlanFarVeneerIsland(const int* pos, int count, int horizon, int reach,
+                               int margin, int* out_idx) {
+  int n = 0;
+  for (int i = 0; i < count; i++) {
+    if (horizon >= pos[i] + reach - margin) out_idx[n++] = i;
+  }
+  for (int a = 1; a < n; a++) {  // insertion sort by pos ascending (tightest first)
+    const int k = out_idx[a];
+    int b = a;
+    while (b > 0 && pos[out_idx[b - 1]] > pos[k]) {
+      out_idx[b] = out_idx[b - 1];
+      --b;
+    }
+    out_idx[b] = k;
+  }
+  return n;
+}
+
+// ADR (T3, ADD form): the emitted instruction computes, at run time,
+// rd = Align(instr_pc + 4, 4) + imm12 (Thumb reads pc as this instruction's
+// address + 4).  Encoded as ADD (immediate) T4 with Rn = 1111 (pc), imm12 =
+// i:imm3:imm8 zero-extended (no ThumbExpand), range [0, 4095]; `pc` here is the
+// address the bytes are written to.  This is the native jump-table dispatch's
+// address-of-table step, mirroring arm64's Adr -- Thumb-2 has no
+// `add pc, pc, Rm, lsl #2`, so the table address is materialised into a scratch,
+// indexed, and reached via bx.  The bit masks below just slice the field widths;
+// they do NOT validate rd or imm12.  The sole production caller (Assembler::
+// WinRTEmitThumbAdr) CHECKs imm12 <= 0xFFF and passes the r12 scratch as rd; a
+// direct caller (e.g. a host-side test) must likewise pass a low register
+// and an in-range imm12 (rd == 13/15 would be UNPREDICTABLE for ADR T3).
+inline void EncodeThumbAdrAdd(Address pc, int rd, uint32_t imm12) {
+  const uint32_t i = (imm12 >> 11) & 1;
+  const uint32_t imm3 = (imm12 >> 8) & 0x7;
+  const uint32_t imm8 = imm12 & 0xFF;
+  SetHalf(pc, static_cast<uint16_t>(0xF20F | (i << 10)));  // ADD.W Rd, pc(1111)
+  SetHalf(pc + 2,
+          static_cast<uint16_t>((imm3 << 12) | ((rd & 0xF) << 8) | imm8));
+}
+
+// Thumb reads pc as the instruction address plus four.
+constexpr int kPcLoadDelta = 4;
+
+// ---- Shared reloc dispatch (the SHIPPED bodies, not a copy) ----------------
+// These free functions carry the native-Thumb reloc decode/patch logic that
+// Assembler::target_address_at / set_target_address_at / RelocInfo::apply /
+// relative_code_target_object_handle_at call (assembler-arm-inl.h), so a
+// host-side test #includes and exercises the EXACT code that
+// ships -- closing the "test tests a copy, not the file" gap.
+// Buffer-only: pc + the emitted bytes, no Assembler/Isolate.
+
+// Decode the target at a native-Thumb reloc pc (T2 LDR-literal pool / movw-movt
+// pair / B.W-BL). Mirrors Assembler::target_address_at's native block.
+inline Address TargetAddressAt(Address pc) {
+  if (IsLdrPcImmediate(pc)) {
+    Address entry = ConstantPoolEntryAddress(pc);
+    DCHECK_EQ(entry & 3, 0);  // 4-aligned pool slot (CheckConstPool realigns)
+    return base::Memory<Address>(entry);
+  }
+  if (IsMovW(pc)) {
+    DCHECK(IsMovT(pc + kPairStride));
+    return static_cast<Address>((MovImmediate(pc + kPairStride) << 16) |
+                                MovImmediate(pc));
+  }
+  DCHECK(IsBOrBl(pc));
+  return pc + BranchOffset(pc) + kPcLoadDelta;
+}
+
+// Patch the target at a native-Thumb reloc pc. Returns the number of code bytes
+// the caller should FlushInstructionCache (0 for a pool slot: no instruction is
+// rewritten). Mirrors Assembler::set_target_address_at's native block, incl. the
+// loud +-16MB range CHECK on the B.W/BL form.
+inline int SetTargetAddressAt(Address pc, Address target) {
+  if (IsLdrPcImmediate(pc)) {
+    Address entry = ConstantPoolEntryAddress(pc);
+    DCHECK_EQ(entry & 3, 0);
+    base::Memory<Address>(entry) = target;
+    return 0;
+  }
+  if (IsMovW(pc)) {
+    DCHECK(IsMovT(pc + kPairStride));
+    SetMovImmediate(pc, static_cast<uint32_t>(target) & 0xFFFF);
+    SetMovImmediate(pc + kPairStride, static_cast<uint32_t>(target) >> 16);
+    return kPairStride + 4;
+  }
+  DCHECK(IsBOrBl(pc));
+  const int32_t new_off = static_cast<int32_t>(target - pc - kPcLoadDelta);
+  CHECK(BOrBlOffsetInRange(new_off));
+  SetBranchOffset(pc, new_off);
+  return 4;
+}
+
+// A RELATIVE_CODE_TARGET is a bare B.W/BL whose pre-relocation offset field holds
+// code_target_index * 4. Mirrors relative_code_target_object_handle_at's decode.
+inline int RelativeCodeTargetIndexAt(Address pc) {
+  DCHECK(IsBOrBl(pc));
+  return BranchOffset(pc) / 4;  // 4 == kInstrSize (arm code-target index unit)
+}
+
+// Relocate a RELATIVE_CODE_TARGET's B.W/BL by -delta on code movement. Mirrors
+// RelocInfo::apply's native block (incl. the +-16MB CHECK).
+inline void ApplyDeltaToBranch(Address pc, intptr_t delta) {
+  DCHECK(IsBOrBl(pc));
+  const int32_t new_off = static_cast<int32_t>(BranchOffset(pc) - delta);
+  CHECK(BOrBlOffsetInRange(new_off));
+  SetBranchOffset(pc, new_off);
+}
+
+// Shared raw 32-bit data-word writer used by BOTH Assembler::emit_data_word
+// (assembler-arm-inl.h) and a host-side test. UNALIGNED by design:
+// dense Thumb leaves pc_ at arbitrary 2-mod-4 parity, and mov_label_offset writes
+// two ADJACENT data words at that parity. base::WriteUnalignedValue is a 4-byte
+// memcpy that lowers to a single unaligned STR; because the uint8_t*/memcpy path
+// gives clang no >=4-alignment proof, it cannot fold the two adjacent writes into
+// one STRD. The aligned-typed alternative `*(uint32_t*)dst` IS merged to STRD
+// (objdump: `strd r1,r2,[r0]`); unaligned STRD is UNPREDICTABLE per the
+// ARM ARM (it happens NOT to fault on Surface 2 / Pro X -- measured -- but relying
+// on that is UB), so this unaligned write is the correct, portable choice.
+// Hoisted so the test exercises THIS body, not a copy. (A negative control
+// confirms the STRD merge.)
+inline void EmitDataWord(uint8_t* dst, uint32_t data) {
+  base::WriteUnalignedValue<uint32_t>(reinterpret_cast<Address>(dst), data);
+}
+
+// Shared emit-time slot lowering: the encode -> length-CHECK -> copy sequence
+// Assembler::emit() runs on each A32 word (assembler-arm-inl.h). Hoisted here so
+// a host-side test exercises THIS body, not a re-implemented copy
+// loop. Writes the dense Thumb bytes to `dst` and
+// returns the real length; FATALs by name on an A32 form with no Thumb lowering
+// (never a silent skip); the CHECK bounds the memcpy in release, not just debug.
+inline int EmitThumbSlot(uint32_t a32, uint8_t* dst) {
+  uint8_t slot[kWinRTThumbSlotSize];
+  int n = 0;
+  if (!WinRTEncodeThumbSlot(a32, slot, &n)) {
+    FATAL("win-arm32 native Thumb: unhandled A32 encoding 0x%08x (%s)", a32,
+          WinRTDescribeArmInstruction(a32));
+  }
+  CHECK(n > 0 && n <= kWinRTThumbSlotSize && (n & 1) == 0);
+  memcpy(dst, slot, n);
+  return n;
+}

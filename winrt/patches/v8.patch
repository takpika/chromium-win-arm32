+#ifndef V8_CODEGEN_ARM_WINRT_THUMB_PATCH_H_
+#define V8_CODEGEN_ARM_WINRT_THUMB_PATCH_H_
+
+#include <cstdint>
+#include <cstring>
+
+#include "src/base/logging.h"
+#include "src/base/memory.h"
+#include "src/codegen/arm/winrt-thumb-encoder.h"

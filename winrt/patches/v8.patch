+  if (tasks.empty()) {
+    WinRTRecomputeFarDeadline();
+    return;
+  }
+  winrt_far_blocked_++;
+  // Flush the const pool BEFORE emitting the island so the island's 4 + 12*m bytes
+  // cannot push a pending pool past kMaxDistToIntPool (the CHECK(delta <= 0xFFF)
+  // abort in CheckConstPool). Legal because the early return above guaranteed
+  // !is_const_pool_blocked().
+  CheckConstPool(true, true);
+  {
+    BlockConstPoolScope block_const_pool(this);
+    // Jump over the island so execution never falls into the trampolines.
+    Label island_end;
+    b(&island_end, al);

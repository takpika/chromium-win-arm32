+    return w.Finish();
+  }
+
+  // Hints live in the MSR/misc space: cond 0011 0010 0000 1111 0000 0000
+  // hint8, and Thumb spells the same set as nop.w with the hint in the low
+  // byte.  NOP itself is the common one; V8 emits it for padding.
+  if ((instr & 0x0FFFFF00) == 0x0320F000) {

+const char* WinRTDescribeArmInstruction(uint32_t instr) {
+  switch ((instr >> 25) & 0x7) {
+    case 0: return "data-processing-register";
+    case 1: return "data-processing-immediate";
+    case 2: return "load-store-immediate";
+    case 3: return "load-store-register";
+    case 4: return "load-store-multiple";
+    case 5: return "branch";
+    case 6: return "coprocessor/vfp";
+    default: return "supervisor/other";
+  }
+}
+
+bool WinRTEncodeThumbSlot(uint32_t instr, uint8_t out[kWinRTThumbSlotSize],
+                          int* out_bytes) {
+  memset(out, 0, kWinRTThumbSlotSize);
+  *out_bytes = 0;  // Stays 0 on every `return false` path (no Finish()).
+  SlotWriter w(out, out_bytes);
+  const uint32_t cond = Cond(instr);
+  if (cond == 0xF) {
+    // Advanced SIMD keeps its operand encoding in Thumb and only respells the
+    // leading byte, and the barriers have fixed encodings.
+    const uint32_t top = instr >> 24;
+    uint32_t t = 0;
+    if (top == 0xF2) {
+      t = 0xEF000000u | (instr & 0x00FFFFFFu);
+    } else if (top == 0xF3) {
+      t = 0xFF000000u | (instr & 0x00FFFFFFu);
+    } else if (top == 0xF4) {
+      // The 0xF4 top byte is SHARED: Advanced SIMD element/structure load-store AND
+      // PLI (preload instruction, immediate/literal: `1111 0100 U101 Rn 1111 imm12`,
+      // [22:20]=101 && [15:12]=1111). Only the SIMD load-store maps to Thumb 0xF9 by a
+      // leading-byte swap; PLI's Thumb spelling is a DIFFERENT encoding (0xF9xx), so a
+      // verbatim respell of PLI produces an unrelated/undefined Thumb word (an A32<->T32
+      // respell differential caught exactly this:
+      // 1024 PLI words respelled to undecodable Thumb). V8's arm backend emits no PLI
+      // (assembler-arm.cc has pld() but it is uncalled, and no pli() at all), so reject
+      // it LOUDLY (never a silent miscompile) rather than lower an instruction that
+      // never reaches here. (PLD is top byte 0xF5 -> the final `return false` below.)
+      if ((instr & 0x0070F000u) == 0x0050F000u) return false;  // PLI immediate/literal
+      t = 0xF9000000u | (instr & 0x00FFFFFFu);
+    } else if ((instr & 0xFFFFFFF0u) == 0xF57FF040u) {  // DSB
+      w.Wide(0xF3BF, static_cast<uint16_t>(0x8F40 | (instr & 0xF)));
+      return w.Finish();
+    } else if ((instr & 0xFFFFFFF0u) == 0xF57FF050u) {  // DMB
+      w.Wide(0xF3BF, static_cast<uint16_t>(0x8F50 | (instr & 0xF)));
+      return w.Finish();
+    } else if ((instr & 0xFFFFFFF0u) == 0xF57FF060u) {  // ISB
+      w.Wide(0xF3BF, static_cast<uint16_t>(0x8F60 | (instr & 0xF)));
+      return w.Finish();
+    } else {
+      return false;  // BLX immediate and the rest of the unconditional space
+    }
+    w.Wide(static_cast<uint16_t>(t >> 16), static_cast<uint16_t>(t & 0xFFFF));
+    return w.Finish();
+  }
+
+  // BKPT: cond 0001 0010 imm12 0111 imm4. A32 BKPT is defined ONLY as unconditional
+  // (cond==AL); every other condition is UNPREDICTABLE and not a valid A32 encoding
+  // (llvm-mc rejects e.g. 0x01200070 = "BKPTEQ" as "invalid instruction encoding"). The
+  // mask above ignores the cond field, so without this guard a conditional BKPT word
+  // would be silently RE-INTERPRETED as an unconditional Thumb bkpt -- reject it loudly
+  // instead (V8 emits BKPT only via bkpt()/stop(), always
+  // unconditional). The Thumb T1 bkpt is itself always-execute, so cond==AL needs no IT.
+  if ((instr & 0x0FF000F0) == 0x01200070) {
+    if (cond != kCondAlways) return false;
+    const uint32_t imm16 = (((instr >> 8) & 0xFFF) << 4) | (instr & 0xF);
+    if (imm16 > 0xFF) return false;
+    w.Half(static_cast<uint16_t>(0xBE00 | imm16));
+    return w.Finish();
+  }
+
+  // Synchronization primitives: LDREX/STREX{,B,H,D}.
+  //   A32: cond 0001 1ooo Rn Rt/Rd 1111 1001 Rt/(1111)
+  //   [27:23]=00011, [7:4]=1001, [11:8]=1111; [23:20] selects the variant.
+  // All have zero-offset Thumb-2 T1 encodings, valid on ARMv7 (Cortex-A15) in
+  // Thumb state; V8 emits them unconditionally.
+  if ((instr & 0x0F8000F0) == 0x01800090 && (instr & 0x00000F00) == 0x00000F00) {
+    if (cond != kCondAlways) return false;  // LDREX/STREX in an IT block is deprecated
+    const uint32_t op = (instr >> 20) & 0xF;
+    const uint32_t rn = (instr >> 16) & 0xF;
+    const uint32_t rt12 = (instr >> 12) & 0xF;  // Rt (loads) or Rd (stores)
+    const uint32_t rt0 = instr & 0xF;           // Rt (stores)
+    // Reject sp/pc in any real register operand -> UNPREDICTABLE Thumb.
+    // Rn==pc and Rt/Rd==pc/sp are UNPREDICTABLE; V8 never emits
+    // an exclusive to sp/pc. rt0 is a real register only for the even (STREX)
+    // variants; for loads its A32 [3:0] field is 1111, not a register.
+    const bool is_store = (op & 1) == 0;

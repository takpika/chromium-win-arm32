+      // form (SXTB/UXTB/...), which Thumb spells with Rn=1111, so it is allowed; Rn==13
+      // (sp accumulate) is UNPREDICTABLE. All three of Rd/Rn/Rm are guarded.
+      if (rd == 15 || rd == 13) return false;
+      if (rm == 15 || rm == 13) return false;
+      if (rn == 13) return false;  // sp accumulate operand UNPREDICTABLE (rn==15 = no-acc)

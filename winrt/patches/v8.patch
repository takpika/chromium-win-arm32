+void Assembler::WinRTCheckFarVeneers(int horizon) {
+  // Never split a fixed-layout sequence or recurse into ourselves. (The drain from
+  // BlockConstPoolFor calls this BEFORE it sets no_const_pool_before_, so
+  // is_const_pool_blocked() is still false for the outermost block and the island

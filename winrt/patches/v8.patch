+      // LDRT/STRT (unprivileged), not LDR/STR (ARM ARM: "if P==1 && U==1 &&
+      // W==0 then SEE LDRT"). All other single-register cases are index/
+      // writeback forms that have no such collision and use T4.
+      if (p == 0 && u == 1 && wb == 0) {                // [rn]
+        w.Wide(static_cast<uint16_t>((l ? 0xF8D0u : 0xF8C0u) | rn),
+               static_cast<uint16_t>((rt1 << 12) | 0u));  // imm12 = 0
+        return w.Finish();
+      }
+      uint32_t pi, ui, wi, imm8;
+      if (p == 0 && u == 1) {           // IA, writeback
+        pi = 0; ui = 1; wi = 1; imm8 = 4;              // [rn], #4
+      } else {                           // DB (p==1, u==0)
+        pi = 1; ui = 0; wi = wb; imm8 = 4;             // [rn, #-4]{!}
+      }
+      w.Wide(static_cast<uint16_t>((l ? 0xF850u : 0xF840u) | rn),
+             static_cast<uint16_t>((rt1 << 12) | 0x0800 | (pi << 10) |
+                                   (ui << 9) | (wi << 8) | imm8));
+      return w.Finish();
+    }
+    // Thumb-2 LDM/STM (T2) UNPREDICTABLE case: a load that lists both lr and pc.
+    // (The writeback-with-base-in-list case is guarded above, before count==1.)
+    if (l && (list & (1u << 15)) && (list & (1u << 14))) return false;
+    if (cond != kCondAlways) EmitIT(&w, cond);
+    // LDM-to-pc (pop {..., pc}) interworking: emit the T2 LDM verbatim. Thumb-2
+    // T2 LDM-to-pc does BXWritePC (interworks via bit0 of the loaded value) -- so,
+    // UNLIKE the single-reg `ldr pc` above (which forces bit0 via a scratch+bx
+    // because it can load a raw, possibly-even code pointer at a computed jump),
+    // this needs no bit-forcing: multi-register LDM-to-pc is only ever an epilogue
+    // RETURN whose pc slot holds a Thumb return address (bit0=1). Device-verified
+    // (pop {r4,pc} returns correctly on both devices).
+    w.Wide(hw1, static_cast<uint16_t>(list));
+    return w.Finish();
+  }
+
+  if (space == 0x0) {
+    const uint32_t opcode = (instr >> 21) & 0xF;
+    const uint32_t set_flags = (instr >> 20) & 1;
+    const uint32_t bits74 = (instr >> 4) & 0xF;
+    const uint32_t rn = (instr >> 16) & 0xF, rd = (instr >> 12) & 0xF;
+    const uint32_t rs = (instr >> 8) & 0xF, rm = instr & 0xF;
+
+    // Multiply family: cond 0000 xxxS Rd Ra Rs 1001 Rm.
+    if (bits74 == 0x9 && ((instr >> 24) & 0xF) == 0x0) {
+      if (set_flags) return false;  // Thumb multiplies never set flags
+      const uint32_t kind = (instr >> 21) & 0x7;
+      // Thumb multiplies require EVERY register operand in {r0-r12, lr} -- sp(13) and
+      // pc(15) are UNPREDICTABLE. Guard them ALL, not just the destination: rn[19:16]
+      // (Rd/RdHi), rm[3:0] (Rn multiplicand), rs[11:8] (Rm multiplier); the long-multiply
+      // RdLo and the MLA/MLS accumulator Ra (both rd[15:12]) are guarded per-kind below.
+      // (Covers RdHi==sp and the rm/rs/Ra fields -- e.g. `mul r0,sp,r0`,
+      // `mla r0,r1,r2,sp`, and `mla rd,rm,rs,pc`, which would silently re-encode to
+      // `mul`.)
+      if (rn == 15 || rn == 13 || rm == 15 || rm == 13 || rs == 15 || rs == 13) {
+        return false;
+      }
+      if ((kind == 0x1 || kind == 0x3) && (rd == 15 || rd == 13)) {
+        return false;  // MLA/MLS accumulator Ra=pc/sp UNPREDICTABLE
+      }
+      if (kind == 0x0) {  // MUL Rd, Rm, Rs
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(static_cast<uint16_t>(0xFB00 | rm),
+               static_cast<uint16_t>(0xF000 | (rn << 8) | rs));
+        return w.Finish();
+      }
+      if (kind == 0x1) {  // MLA Rd, Rm, Rs, Ra
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(static_cast<uint16_t>(0xFB00 | rm),
+               static_cast<uint16_t>((rd << 12) | (rn << 8) | rs));
+        return w.Finish();
+      }
+      if (kind == 0x3) {  // MLS Rd, Rm, Rs, Ra
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(static_cast<uint16_t>(0xFB00 | rm),
+               static_cast<uint16_t>(0x0010 | (rd << 12) | (rn << 8) | rs));
+        return w.Finish();
+      }
+      if (kind >= 0x4) {  // UMULL/UMLAL/SMULL/SMLAL: RdHi = rn, RdLo = rd
+        if (rd == 15 || rd == 13) return false;  // RdLo=pc/sp UNPREDICTABLE
+        uint16_t base;
+        switch (kind) {
+          case 0x4: base = 0xFBA0; break;  // UMULL
+          case 0x5: base = 0xFBE0; break;  // UMLAL
+          case 0x6: base = 0xFB80; break;  // SMULL
+          case 0x7: base = 0xFBC0; break;  // SMLAL
+          default: return false;
+        }
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(static_cast<uint16_t>(base | rm),
+               static_cast<uint16_t>((rd << 12) | (rn << 8) | rs));
+        return w.Finish();
+      }
+      return false;
+    }
+
+    // Halfword / signed / dual loads and stores share the register space:
+    // cond 000 P U I W L Rn Rt imm_hi 1 S H 1 imm_lo.
+    if (bits74 == 0xB || bits74 == 0xD || bits74 == 0xF) {
+      const uint32_t p = (instr >> 24) & 1, u = (instr >> 23) & 1;
+      const uint32_t imm_form = (instr >> 22) & 1, wb = (instr >> 21) & 1;
+      const uint32_t l = (instr >> 20) & 1;
+      const uint32_t sbit = (instr >> 6) & 1, hbit = (instr >> 5) & 1;
+      const uint32_t imm8 = (((instr >> 8) & 0xF) << 4) | (instr & 0xF);
+      if (rn == 15) return false;
+      if (p == 0 && wb == 1) return false;
+      if (sbit && !l) {
+        // LDRD (H=0) / STRD (H=1); Thumb scales the offset by four.
+        if (!imm_form) return false;
+        if (imm8 & 0x3) return false;
+        const uint32_t rt2 = rd + 1;
+        // Thumb T1 LDRD/STRD forbid sp(13)/pc(15) as Rt or Rt2. A32 permits some
+        // of these (e.g. Rt=12 -> Rt2=13), so guard both, not just rt2==15 (the
+        // old `rt2 > 14` missed Rt=12 -> Rt2=sp). Matches the LDREXD/STREXD guard.
+        if (rd == 13 || rd == 15 || rt2 == 13 || rt2 == 15) return false;
+        // Thumb also forbids the base colliding with a transfer register: writeback
+        // with Rn in {Rt,Rt2}, or a LOAD (L=0 here) whose Rn is overwritten by Rt/Rt2,
+        // are UNPREDICTABLE (e.g. `ldrd r0,r1,[r0]!`).
+        const bool writeback = (p == 0) || (wb == 1);
+        const bool is_load = (hbit == 0);  // H=0 -> LDRD, H=1 -> STRD on this path
+        if ((writeback || is_load) && (rn == rd || rn == rt2)) return false;
+        // Reject LDRD/STRD writeback into sp. The encoding is well-formed (the assembler
+        // accepts it) but llvm's disassembler flags base=sp+writeback as potentially
+        // undefined, and V8 arm codegen never emits it (frame ops use push/sub sp), so a
+        // loud FATAL is the conservative choice over a questionable-but-valid form.
+        if (writeback && rn == 13) return false;
+        // Canonicalize NEGATIVE ZERO: A32 `#-0` (U=0, imm=0) and `#+0` are the same
+        // offset, but the Thumb U=0/imm=0 encoding is flagged UNPREDICTABLE (only U=1 is
+        // the canonical zero). Emit U=1 when the offset is zero (e.g.
+        // `ldrd/strd [sp,#-0]!`). Value-preserving.
+        const uint32_t u_canon = (imm8 == 0) ? 1u : u;
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(static_cast<uint16_t>(0xE840 | (p << 8) | (u_canon << 7) |
+                                     (((p == 0) ? 1u : wb) << 5) |
+                                     (hbit ? 0u : 0x10u) | rn),
+               static_cast<uint16_t>((rd << 12) | (rt2 << 8) | (imm8 >> 2)));
+        return w.Finish();
+      }
+      // Single halfword/signed transfer (LDRH/STRH/LDRSH/LDRSB): Thumb forbids
+      // the transfer register Rt(=rd here) being pc(15) or sp(13) -- both are
+      // UNPREDICTABLE and some A32 spellings alias a different Thumb instruction
+      // class (A32 `ldrsb pc,[..]` decodes as PLI in Thumb; `ldrsh pc,[..]` as
+      // <unknown>). Reject loudly rather than silently mis-encode. Not reachable
+      // from V8 arm codegen (no LDRSH/LDRSB into pc/sp) -- this enforces the
+      // "loud reject, never silent miscompile" invariant.
+      if (rd == 15 || rd == 13) return false;
+      uint16_t wide_base, narrow_base;
+      if (!sbit && hbit) {  // LDRH / STRH
+        wide_base = l ? 0xF8B0 : 0xF8A0;
+        narrow_base = l ? 0xF830 : 0xF820;
+      } else if (sbit && hbit) {  // LDRSH
+        wide_base = 0xF9B0;
+        narrow_base = 0xF930;
+      } else if (sbit && !hbit) {  // LDRSB
+        wide_base = 0xF990;
+        narrow_base = 0xF910;
+      } else {
+        return false;
+      }
+      if (imm_form) {
+        uint16_t hw1, hw2;
+        if (p == 1 && u == 1 && wb == 0) {
+          hw1 = static_cast<uint16_t>(wide_base | rn);
+          hw2 = static_cast<uint16_t>((rd << 12) | imm8);
+        } else {
+          const uint32_t enc_w = (p == 0) ? 1u : wb;
+          hw1 = static_cast<uint16_t>(narrow_base | rn);
+          hw2 = static_cast<uint16_t>((rd << 12) | 0x0800 | (p << 10) |
+                                      (u << 9) | (enc_w << 8) | imm8);
+        }
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Wide(hw1, hw2);
+        return w.Finish();
+      }
+      // Register offset: Thumb allows only [Rn, Rm] with no index.
+      if (!(p == 1 && u == 1 && wb == 0)) return false;
+      if (rm == 15 || rm == 13) return false;  // Rm=pc/sp UNPREDICTABLE
+      if (cond != kCondAlways) EmitIT(&w, cond);
+      w.Wide(static_cast<uint16_t>(narrow_base | rn),
+             static_cast<uint16_t>((rd << 12) | rm));
+      return w.Finish();
+    }
+
+    // CLZ: cond 0001 0110 1111 Rd 1111 0001 Rm.
+    if ((instr & 0x0FFF0FF0) == 0x016F0F10) {
+      // Thumb CLZ forbids sp(13)/pc(15) in BOTH Rd and Rm.
+      if (rd == 15 || rd == 13 || rm == 15 || rm == 13) return false;
+      if (cond != kCondAlways) EmitIT(&w, cond);
+      w.Wide(static_cast<uint16_t>(0xFAB0 | rm),
+             static_cast<uint16_t>(0xF080 | (rd << 8) | rm));
+      return w.Finish();
+    }
+
+    // Everything left in this space with opcode 8..B and S == 0 is the
+    // miscellaneous (MRS/MSR/BKPT) block, not a comparison.
+    if (opcode >= 0x8 && opcode <= 0xB && set_flags == 0) return false;
+
+    const ThumbDataOp mapped = MapDataOp(opcode);
+    if (!mapped.valid) return false;
+    const uint32_t s = mapped.force_flags ? 1u : set_flags;
+    const uint32_t enc_rn = mapped.rn_is_pc ? 0xFu : rn;
+    const uint32_t enc_rd = mapped.rd_is_pc ? 0xFu : rd;
+
+    if (((instr >> 4) & 1) == 0) {
+      // Shift by immediate.
+      const uint32_t imm5 = (instr >> 7) & 0x1F;
+      const uint32_t shift_type = (instr >> 5) & 0x3;
+      // A plain `mov rd, rm` is the only form that may name sp, and the 16-bit
+      // encoding is the one that allows it. `mov rd, pc` (rm == 15) is EXCLUDED
+      // here: A32 reads pc as insn+8 while Thumb reads it as this-instr+4, so a
+      // bare Thumb `mov rd, pc` yields a different value; a correct lowering would
+      // need the emit-time pc (like the native ADR emitter uses). It falls through
+      // to the rm == 15 reject below (loud, never silent); V8 arm does not emit it.
+      if (opcode == 0xD && s == 0 && imm5 == 0 && shift_type == 0 && rm != 15) {
+        if (cond != kCondAlways) EmitIT(&w, cond);
+        w.Half(static_cast<uint16_t>(0x4600 | ((rd & 0x8) << 4) | (rm << 3) |
+                                     (rd & 0x7)));
+        return w.Finish();
+      }
+      if (rm == 15) return false;
+      if (!mapped.rn_is_pc && rn == 15) return false;
+      if (!mapped.rd_is_pc && rd == 15) return false;
+      if (imm5 == 0 && shift_type == 0 && (rn == 13 || rm == 13)) {
+        // The 16-bit high-register forms are the only ones that may name sp.
+        if (opcode == 0xA && set_flags) {  // cmp rn, rm
+          if (cond != kCondAlways) EmitIT(&w, cond);
+          w.Half(static_cast<uint16_t>(0x4500 | ((rn & 0x8) << 4) |
+                                       (rm << 3) | (rn & 0x7)));
+          return w.Finish();
+        }
+        if (opcode == 0x4 && !set_flags && rd == rn) {  // add rd, rd, rm
+          if (cond != kCondAlways) EmitIT(&w, cond);
+          w.Half(static_cast<uint16_t>(0x4400 | ((rd & 0x8) << 4) |
+                                       (rm << 3) | (rd & 0x7)));
+          return w.Finish();
+        }
+      }
+      // Thumb-2 ADD/SUB (shifted register, T3) with Rd == sp REQUIRE Rn == sp
+      // (ARM ARM: "if d==13 && n!=13 then UNPREDICTABLE"); Rn == sp with Rd != sp
+      // is fine, and Rm == sp is always UNPREDICTABLE. Other data ops may not
+      // name sp at all.
+      const bool addsub = (opcode == 0x4 || opcode == 0x2);
+      if (rm == 13) return false;
+      if (addsub && !mapped.rd_is_pc && rd == 13 && rn != 13) {
+        // `add/sub sp, Rn, Rm{,shift}` with Rn != sp. REJECTED, not lowered -- same
+        // rationale as the immediate sp form above:
+        // the lowering would need a scratch the encoder cannot prove dead, so the
+        // MACRO-ASSEMBLER owns every `add/sub sp,<non-sp>` for win-arm via an acquired
+        // scratch. No arm codegen site emits the shifted-register form to sp (the known
+        // sp-from-non-sp emitters -- EnterExitFrame, PrepareTailCall, Generate_CEntry --
+        // use the immediate form or avoid sp as destination), so this
+        // is a loud never-fires backstop, never a register clobber on a guessed invariant.
+        return false;
+      }
+      if ((!mapped.rd_is_pc && rd == 13 && !addsub) ||
+          (!mapped.rn_is_pc && rn == 13 && !addsub)) {
+        return false;
+      }
+      // Thumb ADD/SUB (SP plus register, T3) requires the shift be LSL with
+      // amount <= 3 (ARM ARM: other shift types/amounts on `add/sub sp,sp,Rm`
+      // are UNPREDICTABLE). V8 emits only LSL #1/#2 here, so reject anything
+      // else (e.g. `add sp,sp,r0,asr#2`, `lsl#4`) loudly rather than emit an
+      // UNPREDICTABLE sp update -- so sp is fully guarded on the shifted-register
+      // path too.
+      if (addsub && rd == 13 && rn == 13 && (shift_type != 0 || imm5 > 3)) {
+        return false;
+      }
+      if (cond != kCondAlways) EmitIT(&w, cond);
+      w.Wide(
+          static_cast<uint16_t>(0xEA00 | (mapped.op << 5) | (s << 4) | enc_rn),
+          static_cast<uint16_t>(((imm5 >> 2) << 12) | (enc_rd << 8) |
+                                ((imm5 & 0x3) << 6) | (shift_type << 4) | rm));
+      return w.Finish();
+    }
+
+    // Shift by register. Only `mov rd, rm, <shift> rs` has a one-instruction
+    // Thumb form; anything else would need a scratch register this slot has no
+    // safe way to pick.
+    if (((instr >> 7) & 1) == 0 && opcode == 0xD) {
+      const uint32_t shift_type = (instr >> 5) & 0x3;
+      if (rd == 15 || rm == 15 || rs == 15) return false;
+      if (rd == 13 || rm == 13 || rs == 13) return false;
+      if (cond != kCondAlways) EmitIT(&w, cond);
+      w.Wide(static_cast<uint16_t>(0xFA00 | (shift_type << 5) | (s << 4) | rm),
+             static_cast<uint16_t>(0xF000 | (rd << 8) | rs));
+      return w.Finish();
+    }
+
+    // Any other operation with a register-shifted operand: build the shifted
+    // value in a SELF-CONTAINED scratch (no global reservation), then use the
+    // plain register form. Prefer the dead destination; else borrow a temp with
+    // push/pop (data-processing only, so the transient sp shift is invisible).
+    if (((instr >> 7) & 1) == 0) {
+      const uint32_t shift_type = (instr >> 5) & 0x3;
+      if (rm == 15 || rs == 15 || rm == 13 || rs == 13) return false;
+      if (!mapped.rd_is_pc && (rd == 15 || rd == 13)) return false;
+      if (!mapped.rn_is_pc && (rn == 15 || rn == 13)) return false;
+      // A logical flag-setter (ANDS/EORS/ORRS/BICS/TST/TEQ/MVNS Rn,Rm,<shift>Rs)
+      // takes C from the shift carry-out. Emit the shift with S=1 so `movs.w t,
+      // rm,<shift>rs` sets C = shifter carry; the following logical op uses LSL#0,
+      // which leaves C UNCHANGED, so the correct shifter carry survives while N/Z
+      // come from the op's result -- exactly the A32 semantics. Arithmetic ops
+      // take C/V from the ALU, so their shift stays S=0. (MOV register-shifted is
+      // the one-instruction form above.) This makes C correct rather than merely
+      // asserting no consumer reads it.
+      const bool logical_op = opcode == 0x0 || opcode == 0x1 || opcode == 0x8 ||
+                              opcode == 0x9 || opcode == 0xC || opcode == 0xE ||
+                              opcode == 0xF;
+      const uint32_t shift_s = (s && logical_op) ? 1u : 0u;
+      // Only unconditional: a false predicate must leave rd untouched, but the
+      // shift materialisation into rd (which cannot share the op's IT block) would
+      // clobber it. The conditional case falls to the temp path, which rejects it.
+      if (cond == kCondAlways && !mapped.rd_is_pc && !mapped.rn_is_pc &&
+          rd <= 12 && rd != rn && rd != rm && rd != rs) {
+        EmitShiftByRegister(&w, shift_type, rd, rm, rs, shift_s);
+        EmitDataRegister(&w, mapped.op, s, rn, rd, rd, 0, 0);
+        return w.Finish();
+      }
+      if (cond != kCondAlways) return false;
+      uint32_t t = 0;
+      while (t == rn || t == rd || t == rm || t == rs) ++t;  // t <= 4, <= r7
+      w.Half(static_cast<uint16_t>(0xB400 | (1u << t)));  // push {t}
+      EmitShiftByRegister(&w, shift_type, t, rm, rs, shift_s);
+      EmitDataRegister(&w, mapped.op, s, enc_rn, enc_rd, t, 0, 0);
+      w.Half(static_cast<uint16_t>(0xBC00 | (1u << t)));  // pop {t}
+      return w.Finish();
+    }
+    return false;
+  }
+
+  return false;
+}
+
+}  // namespace internal
+}  // namespace v8

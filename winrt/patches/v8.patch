+void Assembler::WinRTEmitThumbLoadFixed8(Register rd, Register base,
+                                         int offset) {
+  CHECK(kWinRTNativeThumbEmit);
+  CHECK(rd != sp && rd != pc && base != sp && base != pc);
+  const uint32_t imm12 = static_cast<uint32_t>(offset < 0 ? -offset : offset);
+  CHECK_LE(imm12, 0xFFFu);
+  BlockConstPoolFor(2);
+  CheckBuffer();
+  const uint32_t i = (imm12 >> 11) & 1;
+  const uint32_t imm3 = (imm12 >> 8) & 0x7;
+  const uint32_t imm8 = imm12 & 0xFF;
+  Address at = reinterpret_cast<Address>(pc_);
+  // ADDW (T4) 0xF200 / SUBW (T4) 0xF2A0: rd = base +/- imm12.
+  winrt_thumb::SetHalf(at, static_cast<uint16_t>((offset < 0 ? 0xF2A0 : 0xF200) |
+                                                 (i << 10) | base.code()));
+  winrt_thumb::SetHalf(at + 2, static_cast<uint16_t>(
+                                   (imm3 << 12) | (rd.code() << 8) | imm8));
+  // LDR.W (T3) rd, [rd, #0].
+  winrt_thumb::SetHalf(at + 4, static_cast<uint16_t>(0xF8D0 | rd.code()));
+  winrt_thumb::SetHalf(at + 6, static_cast<uint16_t>(rd.code() << 12));
+  pc_ += 8;
+}

+void Assembler::WinRTResolveFarBranches(Label* L, int pos) {
+  // Called from bind_to(L), so L->pos()==pos is being established now. Label*
+  // identity is safe: every winrt_far_pending_ /
+  // winrt_far_slots_ entry for L coexists with a LIVE Label-chain link (the branch
+  // was emitted as b/bl(branch_offset(L),al), which links L; islanding only redirects
+  // it via target_at_put, it stays on the chain). So is_linked(L) is TRUE for as long
+  // as an entry names L, and upstream ~Label's DCHECK(!is_linked()) forbids destroying
+  // L while linked -- the entry cannot outlive L and a recycled Label cannot alias it.
+  // This is the property the deleted off-chain conditional veneer pool LACKED (it held
+  // branches with is_linked()==false); here every entry is on-chain.
+  // Point island jump trampolines that target L at `pos` (fill their ldr.w-pc
+  // literal = target|1; islands are always the non-clobbering jump form).
+  for (size_t i = 0; i < winrt_far_slots_.size();) {
+    if (winrt_far_slots_[i].label == L) {
+      const int cell_off = winrt_far_slots_[i].pos;  // buffer offset (for parity)

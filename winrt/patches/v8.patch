+void Assembler::WinRTEmitThumbAdr(Register rd, uint32_t imm12) {
+  CHECK(kWinRTNativeThumbEmit);
+  CHECK_LE(imm12, 0xFFFu);
+  // Block the pool: the immediate is a fixed pc-relative displacement computed by
+  // the caller against this exact position (correct-by-construction).
+  BlockConstPoolFor(1);
+  CheckBuffer();
+  winrt_thumb::EncodeThumbAdrAdd(reinterpret_cast<Address>(pc_), rd.code(),
+                                 imm12);
+  pc_ += 4;
+}

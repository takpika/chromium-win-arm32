diff --git a/crypto/internal.h b/crypto/internal.h
index 63e6a662f16a8103ef9180ac9f69ae9f2b67fcf7..bebe56368f4154b39c0f49997d81e208f706dd95 100644
--- a/crypto/internal.h
+++ b/crypto/internal.h
@@ -146,8 +146,13 @@
 #endif
 #endif
 
+// MinGW builds take POSIX threads from MinGW's runtime (winpthreads). A build
+// with a MinGW compiler that links Microsoft's C runtime instead (Chromium's
+// Windows on ARM32 build, which defines OPENSSL_WINDOWS_CRT_THREADS) has no
+// winpthreads and uses the Windows threads, as MSVC builds do.
 #if defined(OPENSSL_THREADS) && \
-    (!defined(OPENSSL_WINDOWS) || defined(__MINGW32__))
+    (!defined(OPENSSL_WINDOWS) ||  \
+     (defined(__MINGW32__) && !defined(OPENSSL_WINDOWS_CRT_THREADS)))
 #include <pthread.h>
 #define OPENSSL_PTHREADS
 #endif
diff --git a/crypto/thread_win.c b/crypto/thread_win.c
index 3b61bfcfcdc1fde04fe31f0887e88eac6ba28978..22ddc4cdced3d9fa4d35aeee567a431c0af2511e 100644
--- a/crypto/thread_win.c
+++ b/crypto/thread_win.c
@@ -147,7 +147,9 @@ static void NTAPI thread_local_destructor(PVOID module, DWORD reason,
 // Note, in the prefixed build, |p_thread_callback_boringssl| may be a macro.
 #define STRINGIFY(x) #x
 #define EXPAND_AND_STRINGIFY(x) STRINGIFY(x)
-#ifdef _WIN64
+// ARM32 is 32-bit but its C symbols are undecorated (like x64 and arm64); only
+// x86-32 prefixes an underscore.
+#if defined(_WIN64) || defined(_M_ARM) || defined(__arm__)
 __pragma(comment(linker, "/INCLUDE:_tls_used"))
 __pragma(comment(
     linker, "/INCLUDE:" EXPAND_AND_STRINGIFY(p_thread_callback_boringssl)))

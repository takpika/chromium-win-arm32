diff --git a/rtc_base/system/asm_defines.h b/rtc_base/system/asm_defines.h
index a7f6aad272f174419437ad6622eaf09736f33c2e..4e324fcdddf42d45b56ba6fe3080de60ec131c56 100644
--- a/rtc_base/system/asm_defines.h
+++ b/rtc_base/system/asm_defines.h
@@ -36,6 +36,27 @@ bl _\name
 .global _\name
 .private_extern _\name
 .endm
+#elif defined(_WIN32)
+// COFF has no symbol visibility (.hidden is ELF-only); a static-library symbol
+// stays module-private unless exported. `.def ... .type 32` marks the symbol as a
+// function, which on Windows-on-ARM also makes the linker give references to it
+// the Thumb bit.
+.macro GLOBAL_FUNCTION name
+.global \name
+.endm
+.macro DEFINE_FUNCTION name
+.def \name
+.scl 2
+.type 32
+.endef
+\name:
+.endm
+.macro CALL_FUNCTION name
+bl \name
+.endm
+.macro GLOBAL_LABEL name
+.global \name
+.endm
 #else
 .macro GLOBAL_FUNCTION name
 .global \name

+      # its MSVC-less fallback and redefines fseeko before <stdio.h>.
+      defines += [
+        "HAVE_INTTYPES_H",
+        "HAVE_FSEEKO",
+        "_FILE_OFFSET_BITS=64",
+      ]
+    }

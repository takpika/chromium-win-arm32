+    if (current_cpu == "arm") {
+      # Windows on ARM32 is built against the MinGW-w64 CRT, not MSVC's.
+      # Describe it the way FLAC's own configure does for a mingw target:
+      # <inttypes.h> exists (PRId64 etc.), and fseeko/ftello exist with a

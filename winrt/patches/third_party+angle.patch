+unsigned int MeasureDepthBiasResolutionBits(IDirect3DDevice9 *device,
+                                            D3DFORMAT depthFormat,
+                                            unsigned int maxBits)
+{
+    // kColumns one-pixel-wide quads, column i at depth (i + 0.5) / kColumns: a first pass at its
+    // depth, a second pass at the same depth with D3DRS_DEPTHBIAS 2^-b. Where the second loses
+    // LESSEQUAL the first pass's colour stays: the bias is resolved there.
+    constexpr UINT kColumns         = 64;
+    constexpr UINT kRows            = 4;
+    constexpr D3DCOLOR kFirstColor  = D3DCOLOR_ARGB(255, 0, 255, 0);
+    constexpr D3DCOLOR kSecondColor = D3DCOLOR_ARGB(255, 0, 0, 255);
+    constexpr unsigned int kMinBits = 8;
+
+    // Single-sampled surfaces: the resolution does not depend on the sample count (D24S8/D24X8 at
+    // 1x/2x/4x resolve 2^-14 on Tegra 4 and 2^-24 on Adreno).
+    angle::ComPtr<IDirect3DSurface9> colorSurface;
+    angle::ComPtr<IDirect3DSurface9> depthSurface;
+    angle::ComPtr<IDirect3DTexture9> depthTexture;
+    angle::ComPtr<IDirect3DSurface9> readback;
+    if (FAILED(device->CreateRenderTarget(kColumns, kRows, D3DFMT_A8R8G8B8, D3DMULTISAMPLE_NONE, 0,
+                                          FALSE, &colorSurface, nullptr)) ||
+        FAILED(device->CreateOffscreenPlainSurface(kColumns, kRows, D3DFMT_A8R8G8B8,
+                                                   D3DPOOL_SYSTEMMEM, &readback, nullptr)))
+    {
+        return 0;
+    }
+    // A depth-stencil surface, or, for formats ANGLE only creates as depth textures (INTZ), level 0
+    // of a D3DUSAGE_DEPTHSTENCIL texture -- the kind of surface the format is drawn into.
+    if (FAILED(device->CreateDepthStencilSurface(kColumns, kRows, depthFormat, D3DMULTISAMPLE_NONE,
+                                                 0, FALSE, &depthSurface, nullptr)) &&
+        (FAILED(device->CreateTexture(kColumns, kRows, 1, D3DUSAGE_DEPTHSTENCIL, depthFormat,
+                                      D3DPOOL_DEFAULT, &depthTexture, nullptr)) ||
+         FAILED(depthTexture->GetSurfaceLevel(0, &depthSurface))))
+    {
+        return 0;
+    }
+
+    angle::ComPtr<IDirect3DStateBlock9> savedState;
+    angle::ComPtr<IDirect3DSurface9> savedRenderTarget;
+    angle::ComPtr<IDirect3DSurface9> savedDepthStencil;
+    if (FAILED(device->CreateStateBlock(D3DSBT_ALL, &savedState)))
+    {
+        return 0;
+    }
+    device->GetRenderTarget(0, &savedRenderTarget);
+    device->GetDepthStencilSurface(&savedDepthStencil);
+
+    struct Vertex
+    {
+        float x, y, z, rhw;
+        D3DCOLOR color;
+    };
+    Vertex vertices[kColumns * 6];
+
+    device->SetRenderTarget(0, colorSurface.Get());
+    device->SetDepthStencilSurface(depthSurface.Get());
+    const D3DVIEWPORT9 viewport = {0, 0, kColumns, kRows, 0.0f, 1.0f};
+    device->SetViewport(&viewport);
+    device->SetVertexShader(nullptr);
+    device->SetPixelShader(nullptr);
+    device->SetFVF(D3DFVF_XYZRHW | D3DFVF_DIFFUSE);
+    device->SetTexture(0, nullptr);
+    device->SetTextureStageState(0, D3DTSS_COLOROP, D3DTOP_SELECTARG1);
+    device->SetTextureStageState(0, D3DTSS_COLORARG1, D3DTA_DIFFUSE);
+    device->SetTextureStageState(0, D3DTSS_ALPHAOP, D3DTOP_SELECTARG1);
+    device->SetTextureStageState(0, D3DTSS_ALPHAARG1, D3DTA_DIFFUSE);
+    device->SetTextureStageState(1, D3DTSS_COLOROP, D3DTOP_DISABLE);
+    device->SetTextureStageState(1, D3DTSS_ALPHAOP, D3DTOP_DISABLE);
+    device->SetRenderState(D3DRS_LIGHTING, FALSE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FILLMODE, D3DFILL_SOLID);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_STENCILENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_SRGBWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_ALPHA |
+                                                       D3DCOLORWRITEENABLE_BLUE |
+                                                       D3DCOLORWRITEENABLE_GREEN |
+                                                       D3DCOLORWRITEENABLE_RED);
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, TRUE);
+    device->SetRenderState(D3DRS_ZFUNC, D3DCMP_LESSEQUAL);
+    device->SetRenderState(D3DRS_SLOPESCALEDEPTHBIAS, 0);
+
+    auto drawColumns = [&](D3DCOLOR color) {
+        for (UINT i = 0; i < kColumns; i++)
+        {
+            const float z     = (i + 0.5f) / kColumns;
+            const float x0    = i - 0.5f;
+            const float x1    = i + 0.5f;
+            const float y0    = -0.5f;
+            const float y1    = kRows - 0.5f;
+            Vertex *v         = &vertices[i * 6];
+            v[0]              = {x0, y0, z, 1.0f, color};
+            v[1]              = {x1, y0, z, 1.0f, color};
+            v[2]              = {x0, y1, z, 1.0f, color};
+            v[3]              = {x1, y0, z, 1.0f, color};
+            v[4]              = {x1, y1, z, 1.0f, color};
+            v[5]              = {x0, y1, z, 1.0f, color};
+        }
+        device->DrawPrimitiveUP(D3DPT_TRIANGLELIST, kColumns * 2, vertices, sizeof(Vertex));
+    };
+
+    unsigned int resolvedBits = 0;
+    for (unsigned int bits = maxBits; bits >= kMinBits && resolvedBits == 0; bits--)
+    {
+        const float bias = std::ldexp(1.0f, -static_cast<int>(bits));
+        device->Clear(0, nullptr, D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER, 0, 1.0f, 0);
+        if (FAILED(device->BeginScene()))
+        {
+            break;
+        }
+        device->SetRenderState(D3DRS_DEPTHBIAS, 0);
+        drawColumns(kFirstColor);
+        device->SetRenderState(D3DRS_DEPTHBIAS, gl::bitCast<DWORD>(bias));
+        drawColumns(kSecondColor);
+        device->SetRenderState(D3DRS_DEPTHBIAS, 0);
+        device->EndScene();
+
+        D3DLOCKED_RECT locked;
+        if (FAILED(device->GetRenderTargetData(colorSurface.Get(), readback.Get())) ||
+            FAILED(readback->LockRect(&locked, nullptr, D3DLOCK_READONLY)))
+        {
+            break;
+        }
+        const DWORD *row = reinterpret_cast<const DWORD *>(static_cast<const BYTE *>(locked.pBits) +
+                                                           locked.Pitch);
+        bool allResolved = true;
+        for (UINT i = 0; i < kColumns; i++)
+        {
+            allResolved = allResolved && row[i] == kFirstColor;
+        }
+        readback->UnlockRect();
+        if (allResolved)
+        {
+            resolvedBits = bits;
+        }
+    }
+
+    savedState->Apply();
+    device->SetRenderTarget(0, savedRenderTarget.Get());
+    device->SetDepthStencilSurface(savedDepthStencil.Get());
+    return resolvedBits;
+}

+    const gl::VertexArray *vao   = state.getVertexArray();
+    ProgramD3D *programD3D       = GetImplAs<ProgramD3D>(state.getProgram());
+    const auto &semanticIndexes  = programD3D->getAttribLocationToD3DSemantics();
+    const auto &vertexAttributes = vao->getVertexAttributes();
+    const auto &vertexBindings   = vao->getVertexBindings();
+
+    // The vertex of every point.
+    mPointSpriteVertexIndices.resize(count);
+    GLuint maxVertex = 0;
+    if (type == gl::DrawElementsType::InvalidEnum)
+    {
+        for (GLsizei i = 0; i < count; i++)
+        {
+            mPointSpriteVertexIndices[i] = static_cast<GLuint>(first + i);
+        }
+        maxVertex = static_cast<GLuint>(first + count - 1);
+    }
+    else
+    {
+        const uint8_t *indexData       = static_cast<const uint8_t *>(indices);
+        gl::Buffer *elementArrayBuffer = vao->getElementArrayBuffer();
+        if (elementArrayBuffer)
+        {
+            BufferD3D *storage        = GetImplAs<BufferD3D>(elementArrayBuffer);
+            const uint8_t *bufferData = nullptr;
+            ANGLE_TRY(storage->getData(context, &bufferData));
+            indexData = bufferData + reinterpret_cast<intptr_t>(indices);
+        }
+
+        for (GLsizei i = 0; i < count; i++)
+        {
+            GLuint index = 0;
+            switch (type)
+            {
+                case gl::DrawElementsType::UnsignedByte:
+                    index = reinterpret_cast<const GLubyte *>(indexData)[i];
+                    break;
+                case gl::DrawElementsType::UnsignedShort:
+                    index = reinterpret_cast<const GLushort *>(indexData)[i];
+                    break;
+                case gl::DrawElementsType::UnsignedInt:
+                    index = reinterpret_cast<const GLuint *>(indexData)[i];
+                    break;
+                default:
+                    ANGLE_HR_UNREACHABLE(context9);
+            }
+            mPointSpriteVertexIndices[i] = index;
+            maxVertex                    = std::max(maxVertex, index);
+        }
+    }
+
+    // One stream per active attribute, as in VertexDeclarationCache::applyDeclaration(), each
+    // vertex repeated for the four corners, plus the corner stream.
+    struct QuadStream
+    {
+        UINT stream;
+        BYTE usageIndex;
+        const d3d9::VertexFormat *format;
+        const uint8_t *data;
+        size_t stride;  // 0: the same value (current attribute value) for every point
+        UINT offset;
+    };
+    std::array<QuadStream, gl::MAX_VERTEX_ATTRIBS> streams;
+    size_t streamCount = 0;
+    gl::AttributesMask usedStreams;
+
+    for (size_t attribIndex : state.getProgramExecutable()->getActiveAttribLocationsMask())
+    {
+        const gl::VertexAttribute &attrib = vertexAttributes[attribIndex];
+        const gl::VertexBinding &binding  = vertexBindings[attrib.bindingIndex];
+        const gl::VertexAttribCurrentValueData &currentValue =
+            state.getVertexAttribCurrentValue(attribIndex);
+        ASSERT(binding.getDivisor() == 0);
+
+        QuadStream &quadStream = streams[streamCount++];
+        quadStream.stream      = static_cast<UINT>(attribIndex);
+        quadStream.usageIndex  = static_cast<BYTE>(semanticIndexes[attribIndex]);
+        quadStream.format      = &d3d9::GetVertexFormatInfo(
+            mDeviceCaps.DeclTypes, gl::GetVertexFormatID(attrib, currentValue.Type));
+        usedStreams.set(attribIndex);
+
+        if (attrib.enabled)
+        {
+            quadStream.stride  = gl::ComputeVertexAttributeStride(attrib, binding);
+            gl::Buffer *buffer = binding.getBuffer().get();
+            if (buffer)
+            {
+                BufferD3D *storage        = GetImplAs<BufferD3D>(buffer);
+                const uint8_t *bufferData = nullptr;
+                ANGLE_TRY(storage->getData(context, &bufferData));
+
+                const GLintptr offset = gl::ComputeVertexAttributeOffset(attrib, binding);
+                angle::CheckedNumeric<size_t> lastByte = maxVertex;
+                lastByte *= quadStream.stride;
+                lastByte += offset;
+                lastByte += gl::ComputeVertexAttributeTypeSize(attrib);
+                ANGLE_CHECK(context9,
+                            lastByte.IsValid() && lastByte.ValueOrDie() <= storage->getSize(),
+                            "Vertex buffer is not big enough for the draw call.",
+                            GL_INVALID_OPERATION);
+                quadStream.data = bufferData + offset;
+            }
+            else
+            {
+                quadStream.data = static_cast<const uint8_t *>(attrib.pointer);
+            }
+        }
+        else
+        {
+            quadStream.data   = reinterpret_cast<const uint8_t *>(currentValue.Values.FloatValues);
+            quadStream.stride = 0;
+        }
+    }
+
+    const UINT cornerStream    = VertexDeclarationCache::kPointSpriteCornerStream;
+    ASSERT(!usedStreams.test(cornerStream));
+    constexpr UINT kCornerSize = sizeof(kPointSpriteQuadCorners[0]);
+
+    D3DVERTEXELEMENT9 elements[VertexDeclarationCache::kMaxElements];
+    size_t elementCount = 0;
+    for (size_t i = 0; i < streamCount; i++)
+    {
+        D3DVERTEXELEMENT9 &element = elements[elementCount++];
+        element.Stream             = static_cast<WORD>(streams[i].stream);
+        element.Offset             = 0;
+        element.Type               = static_cast<BYTE>(streams[i].format->nativeFormat);
+        element.Method             = D3DDECLMETHOD_DEFAULT;
+        element.Usage              = D3DDECLUSAGE_TEXCOORD;
+        element.UsageIndex         = streams[i].usageIndex;
+    }
+    {
+        D3DVERTEXELEMENT9 &element = elements[elementCount++];
+        element.Stream             = static_cast<WORD>(cornerStream);
+        element.Offset             = 0;
+        element.Type               = D3DDECLTYPE_FLOAT4;
+        element.Method             = D3DDECLMETHOD_DEFAULT;
+        element.Usage              = D3DDECLUSAGE_POSITION;
+        element.UsageIndex         = 0;
+    }
+    static const D3DVERTEXELEMENT9 end = D3DDECL_END();
+    elements[elementCount++]           = end;
+
+    // From here on the device's declaration, streams and raster state differ from what the caches
+    // record. However this function returns, including the ANGLE_TRY error paths below, the next
+    // draw re-applies them.
+    struct ReapplyDrawState
+    {
+        ~ReapplyDrawState()
+        {
+            stateManager->forceSetRasterState();
+            declarationCache->markStateDirty();
+        }
+        StateManager9 *stateManager;
+        VertexDeclarationCache *declarationCache;
+    } reapplyDrawState{&mStateManager, &mVertexDeclarationCache};
+
+    ANGLE_TRY(mVertexDeclarationCache.applyElements(context, mDevice, elements, elementCount));
+
+    StaticIndexBufferInterface *quadIB = nullptr;
+    ANGLE_TRY(getPointSpriteQuadIB(context, &quadIB));
+    if (mAppliedIBSerial != quadIB->getSerial())
+    {
+        mDevice->SetIndices(GetAs<IndexBuffer9>(quadIB->getIndexBuffer())->getBuffer());
+        mAppliedIBSerial = quadIB->getSerial();
+    }
+
+    // Points take the front stencil state (OpenGL ES 2.0 section 4.1.4); with two-sided stencil
+    // D3D picks it by winding, so the quads wind like front-facing triangles: the corner order of
+    // kPointSpriteQuadCorners is counter-clockwise in GL window coordinates. Culling and polygon
+    // offset apply to polygons only.
+    const bool frontFaceCCW   = state.getRasterizerState().frontFace == GL_CCW;
+    const UINT quadStartIndex = frontFaceCCW ? 0 : kPointSpriteQuadIndicesPerDraw;
+    mDevice->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    mDevice->SetRenderState(D3DRS_DEPTHBIAS, 0);
+    mDevice->SetRenderState(D3DRS_SLOPESCALEDEPTHBIAS, 0);
+
+    startScene();
+
+    constexpr GLsizei kQuadsPerDraw = static_cast<GLsizei>(kPointSpriteQuadsPerDraw);
+    for (GLsizei drawStart = 0; drawStart < count; drawStart += kQuadsPerDraw)
+    {
+        const UINT quadCount   = static_cast<UINT>(std::min(count - drawStart, kQuadsPerDraw));
+        const UINT vertexCount = quadCount * 4;
+
+        UINT bufferSize = 0;
+        for (size_t i = 0; i < streamCount; i++)
+        {
+            streams[i].offset = bufferSize;
+            bufferSize += roundUp(
+                static_cast<UINT>(streams[i].format->outputElementSize) * vertexCount, 16u);
+        }
+        const UINT cornerOffset = bufferSize;
+        bufferSize += kCornerSize * vertexCount;
+
+        if (bufferSize > mPointSpriteQuadVBSize)
+        {
+            SafeRelease(mPointSpriteQuadVB);
+            mPointSpriteQuadVBSize = 0;
+            HRESULT result = createVertexBuffer(bufferSize, D3DUSAGE_DYNAMIC | D3DUSAGE_WRITEONLY,
+                                                &mPointSpriteQuadVB);
+            ANGLE_TRY_HR(context9, result, "Failed to create the point sprite vertex buffer");
+            mPointSpriteQuadVBSize = bufferSize;
+        }
+
+        void *mapped   = nullptr;
+        HRESULT result = mPointSpriteQuadVB->Lock(0, bufferSize, &mapped, D3DLOCK_DISCARD);
+        ANGLE_TRY_HR(context9, result, "Failed to lock the point sprite vertex buffer");
+        uint8_t *vertexData = static_cast<uint8_t *>(mapped);
+
+        for (UINT quad = 0; quad < quadCount; quad++)
+        {
+            const GLuint vertex = mPointSpriteVertexIndices[drawStart + quad];
+            for (size_t i = 0; i < streamCount; i++)
+            {
+                const QuadStream &quadStream = streams[i];
+                const size_t elementSize     = quadStream.format->outputElementSize;
+                uint8_t *quadVertices = vertexData + quadStream.offset + quad * 4 * elementSize;
+
+                quadStream.format->copyFunction(quadStream.data + vertex * quadStream.stride,
+                                                quadStream.stride, 1, quadVertices);
+                for (UINT corner = 1; corner < 4; corner++)
+                {
+                    memcpy(quadVertices + corner * elementSize, quadVertices, elementSize);
+                }
+            }
+
+            memcpy(vertexData + cornerOffset + quad * 4 * kCornerSize, kPointSpriteQuadCorners,
+                   4 * kCornerSize);
+        }
+
+        mPointSpriteQuadVB->Unlock();
+
+        for (size_t i = 0; i < streamCount; i++)
+        {
+            mDevice->SetStreamSource(streams[i].stream, mPointSpriteQuadVB, streams[i].offset,
+                                     static_cast<UINT>(streams[i].format->outputElementSize));
+        }
+        mDevice->SetStreamSource(cornerStream, mPointSpriteQuadVB, cornerOffset, kCornerSize);
+
+        mDevice->DrawIndexedPrimitive(D3DPT_TRIANGLELIST, 0, 0, vertexCount, quadStartIndex,
+                                      quadCount * 2);
+    }
+
+    return angle::Result::Continue;
+}
+
+bool Renderer9::drawsFacingsSeparately(const ProgramD3D *programD3D, gl::PrimitiveMode mode) const
+{
+    return getMajorShaderModel() == 2 && programD3D->usesFrontFacing() &&
+           gl::IsTriangleMode(mode);
+}
+
+angle::Result Renderer9::applyTriangleListIndices(const gl::Context *context,
+                                                  gl::PrimitiveMode mode,
+                                                  GLsizei count,
+                                                  gl::DrawElementsType type,
+                                                  const void *indices,
+                                                  UINT *outStartIndex)
+{
+    ASSERT(mode == gl::PrimitiveMode::TriangleStrip || mode == gl::PrimitiveMode::TriangleFan);
+    ASSERT(count >= 3);
+    Context9 *context9 = GetImplAs<Context9>(context);
+
+    // Raw indices of an indexed draw, as in drawLineLoop().
+    const uint8_t *indexData = static_cast<const uint8_t *>(indices);
+    if (type != gl::DrawElementsType::InvalidEnum)
+    {
+        gl::Buffer *elementArrayBuffer =
+            context->getState().getVertexArray()->getElementArrayBuffer();
+        if (elementArrayBuffer)
+        {
+            BufferD3D *storage        = GetImplAs<BufferD3D>(elementArrayBuffer);
+            const uint8_t *bufferData = nullptr;
+            ANGLE_TRY(storage->getData(context, &bufferData));
+            indexData = bufferData + reinterpret_cast<intptr_t>(indices);
+        }
+    }
+    auto sourceIndex = [type, indexData](GLsizei i) -> GLuint {
+        switch (type)
+        {
+            case gl::DrawElementsType::UnsignedByte:
+                return reinterpret_cast<const GLubyte *>(indexData)[i];
+            case gl::DrawElementsType::UnsignedShort:
+                return reinterpret_cast<const GLushort *>(indexData)[i];
+            case gl::DrawElementsType::UnsignedInt:
+                return reinterpret_cast<const GLuint *>(indexData)[i];
+            default:
+                return static_cast<GLuint>(i);  // Non-indexed draw
+        }
+    };
+
+    // Triangle t of a strip is (t, t+1, t+2) for even t and (t+1, t, t+2) for odd t, which keeps
+    // every triangle's winding; triangle t of a fan is (0, t+1, t+2).
+    const bool uint32Indices = getNativeExtensions().elementIndexUintOES;
+    const gl::DrawElementsType indexType =
+        uint32Indices ? gl::DrawElementsType::UnsignedInt : gl::DrawElementsType::UnsignedShort;
+    const size_t indexSize = uint32Indices ? sizeof(GLuint) : sizeof(GLushort);
+    const size_t triangleCount = static_cast<size_t>(count) - 2;
+
+    ANGLE_CHECK(context9,
+                triangleCount * 3 <= std::numeric_limits<unsigned int>::max() / indexSize &&
+                    (uint32Indices || type != gl::DrawElementsType::InvalidEnum ||
+                     count <= std::numeric_limits<GLushort>::max() + 1),
+                "Failed to create a triangle list index buffer, too many indices required.",
+                GL_OUT_OF_MEMORY);
+
+    if (!mTriangleListIB)
+    {
+        mTriangleListIB = new StreamingIndexBufferInterface(this);
+        ANGLE_TRY(
+            mTriangleListIB->reserveBufferSpace(context, INITIAL_INDEX_BUFFER_SIZE, indexType));
+    }
+
+    const unsigned int spaceNeeded = static_cast<unsigned int>(triangleCount * 3 * indexSize);
+    ANGLE_TRY(mTriangleListIB->reserveBufferSpace(context, spaceNeeded, indexType));
+
+    void *mappedMemory  = nullptr;
+    unsigned int offset = 0;
+    ANGLE_TRY(mTriangleListIB->mapBuffer(context, spaceNeeded, &mappedMemory, &offset));
+
+    for (size_t t = 0; t < triangleCount; t++)
+    {
+        const GLsizei i = static_cast<GLsizei>(t);
+        GLuint triangle[3];
+        if (mode == gl::PrimitiveMode::TriangleFan)
+        {
+            triangle[0] = sourceIndex(0);
+            triangle[1] = sourceIndex(i + 1);
+            triangle[2] = sourceIndex(i + 2);
+        }
+        else
+        {
+            triangle[0] = sourceIndex((t % 2 == 0) ? i : i + 1);
+            triangle[1] = sourceIndex((t % 2 == 0) ? i + 1 : i);
+            triangle[2] = sourceIndex(i + 2);
+        }
+
+        for (size_t v = 0; v < 3; v++)
+        {
+            if (uint32Indices)
+            {
+                static_cast<GLuint *>(mappedMemory)[t * 3 + v] = triangle[v];
+            }
+            else
+            {
+                static_cast<GLushort *>(mappedMemory)[t * 3 + v] =
+                    static_cast<GLushort>(triangle[v]);
+            }
+        }
+    }
+
+    ANGLE_TRY(mTriangleListIB->unmapBuffer(context));
+
+    if (mAppliedIBSerial != mTriangleListIB->getSerial())
+    {
+        mDevice->SetIndices(GetAs<IndexBuffer9>(mTriangleListIB->getIndexBuffer())->getBuffer());
+        mAppliedIBSerial = mTriangleListIB->getSerial();
+    }
+
+    *outStartIndex = offset / static_cast<unsigned int>(indexSize);
+    return angle::Result::Continue;
+}
+
+angle::Result Renderer9::drawTrianglesPerFacing(const gl::Context *context,
+                                                gl::PrimitiveMode mode,
+                                                GLsizei count,
+                                                gl::DrawElementsType type,
+                                                const void *indices,
+                                                int minIndex,
+                                                UINT vertexCount,
+                                                UINT startIndex)
+{
+    // ps_2_x has no VFACE: the pixel shader takes the facing of the triangles being drawn from
+    // dx_DepthFront.z (DynamicHLSL::generateShaderLinkHLSL), so a draw may only rasterize
+    // triangles of one facing, which the cull mode selects.
+    const gl::RasterizerState &rasterizer = context->getState().getRasterizerState();
+    bool indexed                          = (type != gl::DrawElementsType::InvalidEnum);
+
+    if (rasterizer.cullFace)
+    {
+        // Only one facing is rasterized anyway (FrontAndBack is skipped, see skipDraw()).
+        mStateManager.setFrontFacingPassConstant(
+            rasterizer.cullMode == gl::CullFaceMode::Back ? 1.0f : -1.0f);
+        if (indexed)
+        {
+            mDevice->DrawIndexedPrimitive(mPrimitiveType, -minIndex, minIndex, vertexCount,
+                                          startIndex, mPrimitiveCount);
+        }
+        else
+        {
+            mDevice->DrawPrimitive(mPrimitiveType, 0, mPrimitiveCount);
+        }
+        return angle::Result::Continue;
+    }
+
+    // Without culling both facings can be present and blending, depth and stencil make the
+    // result depend on the order of the triangles. Each triangle is therefore drawn on its own,
+    // in order, once culling back-facing and once culling front-facing triangles: exactly one of
+    // the two rasterizes it. Strips and fans become triangle lists so that every triangle keeps
+    // its winding (which also selects the two-sided stencil state) when drawn alone.
+    D3DPRIMITIVETYPE primitiveType = mPrimitiveType;
+    if (mode != gl::PrimitiveMode::Triangles)
+    {
+        ANGLE_TRY(applyTriangleListIndices(context, mode, count, type, indices, &startIndex));
+        primitiveType = D3DPT_TRIANGLELIST;
+        indexed       = true;
+        if (type == gl::DrawElementsType::InvalidEnum)
+        {
+            minIndex    = 0;
+            vertexCount = static_cast<UINT>(count);
+        }
+    }
+
+    const D3DCULL cullBackFacing =
+        gl_d3d9::ConvertCullMode(gl::CullFaceMode::Back, rasterizer.frontFace);
+    const D3DCULL cullFrontFacing =
+        gl_d3d9::ConvertCullMode(gl::CullFaceMode::Front, rasterizer.frontFace);
+
+    const UINT triangleCount = static_cast<UINT>(mPrimitiveCount);
+    for (UINT triangle = 0; triangle < triangleCount; triangle++)
+    {
+        for (const bool frontFacing : {true, false})
+        {
+            mDevice->SetRenderState(D3DRS_CULLMODE, frontFacing ? cullBackFacing : cullFrontFacing);
+            mStateManager.setFrontFacingPassConstant(frontFacing ? 1.0f : -1.0f);
+            if (indexed)
+            {
+                mDevice->DrawIndexedPrimitive(primitiveType, -minIndex, minIndex, vertexCount,
+                                              startIndex + triangle * 3, 1);
+            }
+            else
+            {
+                mDevice->DrawPrimitive(primitiveType, triangle * 3, 1);
+            }
+        }
+    }
+
+    // The next draw re-applies the cull mode.
+    mStateManager.forceSetRasterState();
+    return angle::Result::Continue;
+}

+angle::Result Renderer9::getPointSpriteQuadIB(const gl::Context *context,
+                                              StaticIndexBufferInterface **outIB)
+{
+    if (!mPointSpriteQuadIB)
+    {
+        // Two triangles per quad, kPointSpriteQuadsPerDraw quads whose triangles are
+        // counter-clockwise in GL window coordinates, followed by the same quads clockwise.
+        const unsigned int spaceNeeded = 2 * kPointSpriteQuadIndicesPerDraw * sizeof(GLushort);
+
+        std::unique_ptr<StaticIndexBufferInterface> indexBuffer(
+            new StaticIndexBufferInterface(this));
+        ANGLE_TRY(indexBuffer->reserveBufferSpace(context, spaceNeeded,
+                                                  gl::DrawElementsType::UnsignedShort));
+
+        void *mappedMemory = nullptr;
+        ANGLE_TRY(indexBuffer->mapBuffer(context, spaceNeeded, &mappedMemory, nullptr));
+
+        static constexpr GLushort kCounterClockwise[6] = {0, 1, 2, 0, 2, 3};
+        static constexpr GLushort kClockwise[6]        = {0, 2, 1, 0, 3, 2};
+        GLushort *data                                 = static_cast<GLushort *>(mappedMemory);
+        for (UINT quad = 0; quad < kPointSpriteQuadsPerDraw; quad++)
+        {
+            for (UINT i = 0; i < 6; i++)
+            {
+                data[quad * 6 + i] = static_cast<GLushort>(quad * 4 + kCounterClockwise[i]);
+                data[kPointSpriteQuadIndicesPerDraw + quad * 6 + i] =
+                    static_cast<GLushort>(quad * 4 + kClockwise[i]);
+            }
+        }
+
+        ANGLE_TRY(indexBuffer->unmapBuffer(context));
+        mPointSpriteQuadIB = indexBuffer.release();
+    }
+
+    *outIB = mPointSpriteQuadIB;
+    return angle::Result::Continue;
+}

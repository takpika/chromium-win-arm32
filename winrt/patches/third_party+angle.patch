+angle::Result Renderer9::getZeroPointSpriteCornerVB(const gl::Context *context,
+                                                    IDirect3DVertexBuffer9 **outVB)
+{
+    if (!mZeroPointSpriteCornerVB)
+    {
+        // Published only once written, so a failed Lock leaves no unwritten buffer behind.
+        constexpr UINT kSize                = 4 * sizeof(float);
+        IDirect3DVertexBuffer9 *zeroCorner = nullptr;
+        HRESULT result = createVertexBuffer(kSize, D3DUSAGE_WRITEONLY, &zeroCorner);
+        ANGLE_TRY_HR(GetImplAs<Context9>(context), result,
+                     "Failed to create the point sprite corner vertex buffer");
+
+        void *mapped = nullptr;
+        result       = zeroCorner->Lock(0, kSize, &mapped, 0);
+        if (FAILED(result))
+        {
+            SafeRelease(zeroCorner);
+        }
+        ANGLE_TRY_HR(GetImplAs<Context9>(context), result,
+                     "Failed to lock the point sprite corner vertex buffer");
+        memset(mapped, 0, kSize);
+        zeroCorner->Unlock();
+        mZeroPointSpriteCornerVB = zeroCorner;
+    }
+
+    *outVB = mZeroPointSpriteCornerVB;
+    return angle::Result::Continue;
+}

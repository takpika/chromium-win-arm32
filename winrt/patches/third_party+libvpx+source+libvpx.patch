 #endif
+#define THREADFN VPX_FORCE_ALIGN_ARG_POINTER unsigned int __stdcall
 #define THREAD_RETURN(val) (unsigned int)((DWORD_PTR)val)
 
 #if _WIN32_WINNT >= 0x0501  // Windows XP or greater

+// Thumb-2 branch immediates (ARM ARM A8.8.18 B T3/T4, A8.8.25 BL T1).
+// T4/T1: imm32 = SignExtend(S:I1:I2:imm10:imm11:'0'), I1 = NOT(J1 XOR S),
+// I2 = NOT(J2 XOR S). T3: imm32 = SignExtend(S:J2:J1:imm6:imm11:'0').
+static int64_t decodeThumbBranch24(const uint8_t *Bytes) {
+  uint32_t Hi = support::endian::read16le(Bytes);
+  uint32_t Lo = support::endian::read16le(Bytes + 2);
+  uint32_t S = (Hi >> 10) & 1, J1 = (Lo >> 13) & 1, J2 = (Lo >> 11) & 1;
+  uint32_t I1 = !(J1 ^ S), I2 = !(J2 ^ S);
+  uint32_t Imm = (S << 24) | (I1 << 23) | (I2 << 22) | ((Hi & 0x3ff) << 12) |
+                 ((Lo & 0x7ff) << 1);
+  return SignExtend64<25>(Imm);
+}
+
+static int64_t decodeThumbBranch20(const uint8_t *Bytes) {
+  uint32_t Hi = support::endian::read16le(Bytes);
+  uint32_t Lo = support::endian::read16le(Bytes + 2);
+  uint32_t Imm = (((Hi >> 10) & 1) << 20) | (((Lo >> 11) & 1) << 19) |
+                 (((Lo >> 13) & 1) << 18) | ((Hi & 0x3f) << 12) |
+                 ((Lo & 0x7ff) << 1);
+  return SignExtend64<21>(Imm);
+}
+
+// MOVW/MOVT (T3/T1) immediate: imm16 = imm4:i:imm3:imm8.
+static uint16_t decodeThumbMovImm(const uint8_t *Bytes) {
+  uint32_t Hi = support::endian::read16le(Bytes);
+  uint32_t Lo = support::endian::read16le(Bytes + 2);
+  return ((Hi & 0xf) << 12) | (((Hi >> 10) & 1) << 11) | (((Lo >> 12) & 7) << 8) |
+         (Lo & 0xff);
+}
+
+static void encodeThumbBranch24(uint8_t *Bytes, int64_t Disp) {
+  if (!isInt<25>(Disp) || (Disp & 1))
+    report_fatal_error("Thumb branch relocation out of range");
+  uint32_t S = Disp < 0 ? 1 : 0;
+  uint32_t J1 = (((Disp >> 23) & 1) ^ 1) ^ S;
+  uint32_t J2 = (((Disp >> 22) & 1) ^ 1) ^ S;
+  uint32_t Hi = support::endian::read16le(Bytes);
+  uint32_t Lo = support::endian::read16le(Bytes + 2);
+  Hi = (Hi & 0xf800) | (S << 10) | ((Disp >> 12) & 0x3ff);
+  Lo = (Lo & 0xd000) | (J1 << 13) | (J2 << 11) | ((Disp >> 1) & 0x7ff);
+  support::endian::write16le(Bytes, Hi);
+  support::endian::write16le(Bytes + 2, Lo);
+}
+
+static void encodeThumbBranch20(uint8_t *Bytes, int64_t Disp) {
+  if (!isInt<21>(Disp) || (Disp & 1))
+    report_fatal_error("Thumb conditional branch relocation out of range");
+  uint32_t Hi = support::endian::read16le(Bytes);
+  uint32_t Lo = support::endian::read16le(Bytes + 2);
+  Hi = (Hi & 0xfbc0) | ((Disp < 0 ? 1 : 0) << 10) | ((Disp >> 12) & 0x3f);
+  Lo = (Lo & 0xd000) | (((Disp >> 18) & 1) << 13) | (((Disp >> 19) & 1) << 11) |
+       ((Disp >> 1) & 0x7ff);
+  support::endian::write16le(Bytes, Hi);
+  support::endian::write16le(Bytes + 2, Lo);
+}

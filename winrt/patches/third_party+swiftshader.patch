+                     static_cast<int64_t>(P + 4);
+      LLVM_DEBUG(dbgs() << "\t\tOffset: " << RE.Offset << " RelType: "
+                        << (RE.RelType == COFF::IMAGE_REL_ARM_BLX23T
+                                ? "IMAGE_REL_ARM_BLX23T"
+                                : "IMAGE_REL_ARM_BRANCH24T")
+                        << " Value: " << static_cast<int32_t>(Disp) << '\n');
+      encodeThumbBranch24(Target, Disp);
+      if (RE.RelType == COFF::IMAGE_REL_ARM_BLX23T)
+        support::endian::write16le(
+            Target + 2, support::endian::read16le(Target + 2) | 0x1000);
       break;
     }
     }
